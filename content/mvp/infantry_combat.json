{
  // Infantry combat, the ground and the soldier's senses (INF-E1b-1; docs/design.md, "Infantry combat: the ground and the senses";
  // the game repo's docs/plans/infantry-battle-rules.md sections 4, 5, 9 and 21 to 23, and infantry-combat-brief.md 6.2 to 6.7).
  // Both sides alike. Distances in tenths of a cell, times in ticks (20 a second), percents. Starting values for tuning.
  "infantryCombat": {
    // Danger classes of contacts that are not soldiers, by tag (the first list the unit has a tag of).
    "armourTags": ["tank"], "lightVehicleTags": ["vehicle"], "helicopterTags": ["aircraft"],
    // Each small arm: its class (the danger table, 4.4), its sound range (brief 6.2) and its suppression a shot (brief 6.6).
    "weapons": {
      "res_rifle": { "class": "rifle", "sound": 250, "suppress": 4 },
      "rifle": { "class": "rifle", "sound": 250, "suppress": 4 },
      "res_carbine": { "class": "carbine", "sound": 250, "suppress": 4 },
      "short_rifle": { "class": "carbine", "sound": 250, "suppress": 4 },
      "res_smg": { "class": "smg", "sound": 200, "suppress": 3 },
      "smg": { "class": "smg", "sound": 200, "suppress": 3 },
      "res_pistol": { "class": "pistol", "sound": 150, "suppress": 2 },
      "pistol": { "class": "pistol", "sound": 150, "suppress": 2 },
      "res_lmg": { "class": "lmg", "sound": 300, "suppress": 7 },
      "lmg": { "class": "lmg", "sound": 300, "suppress": 7 },
      "res_sniper": { "class": "marksman", "sound": 400, "suppress": 12 },
      "sniper_rifle": { "class": "marksman", "sound": 400, "suppress": 12 },
      "at_missile": { "class": "launcher", "sound": 500, "suppress": 0 },
      "aa_missile": { "class": "crew", "sound": 500, "suppress": 0 }
    },
    // 4: reaction ticks (seeded min-max; surprise when shot at first), memory (seen before 6 s, heard 10 s, reported 8 s), sharing
    // (squad 0.2 s, neighbours within 15 cells 1 s, allies 2 s), caps (8 a soldier, 16 a squad, 8 heard areas a think), alert 12
    // cells, reach 120% of range, in contact within 150% of his own range or shot at in 3 s; a heard area is a 6-cell square (half
    // 3) offset 0-2 cells, merged within 3 cells, its draw fixed for 200 ticks; firing reveals for 3 s within range + 3 cells;
    // effective fire = 2 shots in 2 s or a hit in 3 s; near = 1.5 cells; the axis moves after 2 steps for 20 ticks; two fronts 11
    // steps apart, danger 20 each. Distances in tenths of a cell.
    "perception": { "reactMin": 6, "reactMax": 12, "surpriseMin": 12, "surpriseMax": 20, "shareReact": 4, "laterContact": 4, "rankRegular":
      1, "rankVeteran": 2, "rankElite": 4, "reactFloor": 2, "seenMemory": 120, "heardMemory": 200, "reportedMemory": 160,
      "squadShareTicks": 4, "nearShareTicks": 20, "allyShareTicks": 40, "shareRadius": 150, "contactsPerSoldier": 8,
      "contactsPerSquad": 16, "alertRange": 120, "reachPercent": 120, "contactRangePercent": 150, "shotAtMemoryTicks": 60,
      "heardPerThink": 8, "areaHalf": 30, "areaOffset": 20, "areaMerge": 30, "areaTicks": 200, "fireRevealTicks": 60,
      "fireRevealExtra": 30, "effectiveShots": 2, "effectiveTicks": 40, "effectiveHitTicks": 60, "nearShot": 15, "axisSteps":
      2, "axisTicks": 20, "twoFrontSteps": 11, "twoFrontDanger": 20 },
    // 4.4: harm a second to a soldier standing in the open, a rifleman = 10; halved when not seen now, doubled when firing at us;
    // reaches in tenths of a cell where the class has a fixed one.
    "danger": { "rifle": 10, "carbine": 8, "smg": 9, "pistol": 4, "lmg": 22, "lmgDeployed": 28, "marksman": 14, "marksmanOthers": 4,
      "launcher": 12, "launcherReach": 40, "crew": 6, "crewReach": 40, "unknown": 10, "lightVehicle": 25, "armour": 60,
      "helicopter": 50, "area": 10, "areaMax": 30, "areaReach": 60 },
    // 5.3: postureHit (stand, crouch, kneel, prone), concealFactor 60 when concealed and not seen by that enemy in 3 s,
    // rangeFactor 100 to 60% of range, 60 at range, 30 out to reach; lowStanding: the share of low cover a standing man keeps (his
    // legs).
    "exposure": { "stand": 100, "crouch": 80, "kneel": 80, "prone": 50, "concealed": 60, "concealSeenTicks": 60, "nearRange": 60,
      "atRange": 60, "inReach": 30, "lowStanding": 25 },
    // 5.1, 5.2 (brief 6.4 table): protection percent firing and ducked; crest flag 4 cells out; rebuilds 400 cells a tick, 2 cells
    // round a change; structures checked every 20 ticks; a structure 2 m or taller (4 half metres) is high cover; forest density
    // 2+ (grove, dense) conceals.
    "cover": { "lowFiring": 55, "lowDucked": 85, "highFiring": 60, "highDucked": 90, "softFiring": 35, "softDucked": 50, "crestReach":
      4, "rebuildCells": 400, "rebuildMargin": 2, "structureTicks": 20, "tallHalfMetres": 4, "concealDensity": 2 },
    // 9, brief 6.3: change times in ticks (stand-crouch 0.4 s, stand-kneel 0.6 s, crouch-kneel 0.2 s, down to prone 0.8 s, prone
    // to stand 1.2 s, prone to crouch or kneel 0.8 s), held at least 20 ticks; prone under effective fire from beyond 70% of the
    // shooter's range; speeds (crouch walk 60%, crawl 20%, pinned -25%); aim by posture; cover within 1 cell (pinned hard) or 2
    // cells (pinned).
    "posture": { "standCrouch": 8, "standKneel": 12, "crouchKneel": 4, "downProne": 16, "proneUp": 24, "proneCrouch": 16,
      "postureHoldTicks": 20, "proneFireRangePercent": 70, "crawlSpeed": 20, "pinnedSpeed": 75, "aimStand":
      100, "aimCrouch": 110, "aimKneel": 115, "aimProne": 125, "pinnedCover": 10, "proneCover": 20 },
    // brief 6.6: a hit +15, a squadmate killed within 3 cells +10, an explosion +40 at its centre to 0 at 200% of its splash;
    // gains x50% in hard cover facing the fire, x75% soft, x75% prone; nothing for 1.5 s, then decay (hundredths a tick: 100 = 20
    // a second); levels 30, 60, 90; aim -15% and -35%; a medic under suppression 60 waits in cover unless his downed man has under
    // 10 s of bleeding left.
    "suppression": { "hit": 15, "mateKilled": 10, "mateReach": 30, "blast": 40, "blastReachPercent": 200, "hardCover": 50, "softCover": 75,
      "prone": 75, "holdTicks": 30, "decay": 100, "shaken": 30, "pinned": 60, "pinnedHard": 90, "aimShaken": 15, "aimPinned":
      35, "medicBleedTicks": 200 },
    // 5.4: an impact (splash 1.5 cells or more) 25 within 3 cells, 10 out to 5, for 15 s; burning ground 50; at most 64 zones.
    "zones": { "impact": 25, "impactReach": 30, "impactOuter": 10, "impactOuterReach": 50, "impactTicks": 300, "minSplash": 15, "fire":
      50, "max": 64 },
    // INF-E1b-2, the soldier's think. 7.2: gait speeds (percent of his content speed), his accuracy and the hit factor on him while
    // moving (instead of his posture's); the crouched gaits 80% of the gait and 5 points more accurate; sprint 120% for at most
    // 10 s, then 10 s of rest; an LMG gunner -15% and -30% accuracy from the hip; reloading on the move at half the gait.
    "gaits": { "walk": 50, "strafe": 45, "backpedal": 35, "crouchGait": 80, "crouchRun": 75, "run": 100, "sprint": 120, "walkAim": 80,
      "strafeAim": 75, "backAim": 65, "crouchAimPlus": 5, "crouchHit": 85, "runHit": 90, "crawlHit": 50, "sprintTicks": 200,
      "sprintRest": 200, "lmgSpeed": 85, "lmgHipAim": 70, "reloadMove": 50, "riseMove": 60 },
    // 7.1, 7.3: advance within 4 steps of the 32 (45 deg), strafe up to 12 (135 deg), backpedal beyond; a run in contact only within
    // 9 steps (100 deg) of the axis; a turn over 90 deg (8 facings) takes 8 ticks without firing; the body faces contacts of danger
    // 10+; out of reach beyond 120% of their range, or nobody spotted him for 40 ticks.
    "facing": { "advanceSteps": 4, "backSteps": 12, "runSteps": 9, "bigTurn": 8, "bigTurnTicks": 8, "faceDanger": 10, "outOfReachPercent":
      120, "unspottedTicks": 40 },
    // 6: the worth-it rule (a 15% gain), the dash limits (3 s under fire, 6 s in contact, 10 s out of it), the horizons by the
    // squad's choice (E1b-3 sets the choice; today: fight in place 300, loose 200, alert 300), shaken x80%, wounded x120%; the
    // candidates (cover facing the axis within 5 steps, or concealment) within 4, 6 or 8 cells, at most 16, a flood of at most 240
    // cells, path exposure every 2 cells; spacing 1.5 cells (1 behind hard cover), a squadmate's fire line 0.5 cells; the terms
    // (no line of fire +30, a heavy weapon +60, the band +20 per 10%, bunching +10 within 2 cells, all x H / 100); a search a
    // second in contact, every 4 s while the spot is good (in cover, exposure not up by a quarter), 2 s at a new spot unless its
    // exposure doubles; an unreachable cell is skipped for 5 s; at most 24 searches a tick; a building's door: 40 ticks to go in,
    // inside 90% ducked / 60% firing; the LMG's low cover x70%, high x150%; the sniper's concealment x50%.
    "position": { "gainNeeded": 15, "dashFire": 60, "dashContact": 120, "dashCalm": 200, "hFight": 300, "hAdvance": 100, "hWithdraw": 80,
      "hLoose": 200, "hAlert": 300, "hFlank": 200, "shakenH": 80, "woundedH": 120, "radiusFire": 4, "radiusContact": 6, "radiusCalm": 8,
      "maxCandidates": 16, "floodCells": 240, "coverSteps": 5, "minSpacing": 15, "coverSpacing": 10, "fireLineClear": 5, "noFireLine":
      30, "noFireLineHeavy": 60, "bandTerm": 20, "spreadTerm": 10, "spreadReach": 20, "searchTicks": 20, "goodTicks": 80, "risePercent":
      125, "stayTicks": 40, "doublePercent": 200, "unreachableTicks": 100, "pathSample": 2, "searchesPerTick": 24, "enterTicks": 40,
      "insideDucked": 90, "insideFiring": 60, "lmgLow": 70, "lmgHigh": 150, "sniperConceal": 50 },
    // 15: a down enemy's threat 10 (only when no able enemy is a target); sectors 130 / 100 / 70; focus 150; stick 125; overkill 50
    // past the share (at least 2); no aimed shot under a 10% hit chance; a new target 4 to 8 ticks after the old one is lost; heavy
    // threats x150%; a focus kept 2 s out of sight, a marksman one who fired in 10 s; bursts (rifle 3-5, smg 6, lmg 8-12, pistol
    // 2-3, marksman 1) then 10 to 30 ticks (20 to 40 on the move); a third of the squad reloading at once, the rest firing down to
    // 20%; a tactical reload at 30% after 20 ticks without a target; from concealment the first shot needs 50% (or the squad's).
    // Spotters feed the long-reach weapons (15.1, INF-MOVE-6): sideSightWeapons reach beyond their crew's sight (the Kornet: sight
    // 13.5 cells, reach 29 to 36), so on Guard and Aggressive they also take the enemies their side sees now, from where they stand.
    "targeting": { "sideSightWeapons": ["kornet_atgm"], "downThreat": 10, "sectorIn": 130, "sectorNext": 100, "sectorOut": 70, "focus": 150, "stick": 125, "overkill": 50,
      "shareMin": 2, "minScore": 100, "retargetMin": 4, "retargetMax": 8, "heavyThreat": 150, "focusLostTicks": 40, "marksmanTicks":
      200, "burstMin": 3, "burstMax": 5, "burstSmg": 6, "burstLmgMin": 8, "burstLmgMax": 12, "burstPistolMin": 2, "burstPistolMax": 3,
      "waitMin": 10, "waitMax": 30, "moveWaitMin": 20, "moveWaitMax": 40, "reloadShare": 3, "keepFiring": 20, "tacticalReload": 30,
      "noTargetTicks": 20, "openFireChance": 500 },
    // 14.1 to 14.3: thrown 1.5 to 3.5 cells (prone 2.5) at an enemy seen in the last 2 s in hard cover facing him (his hit chance
    // under 30%), no friend within 2 cells of the aim, not pinned hard, the squad's 4 s cooldown; 16 ticks to throw, 15 in the air,
    // landing within 0.5 cells (a recruit 1, an elite 0.3), going off 50 ticks after release; 45 at the centre to 0 at 2 cells,
    // halved prone; a danger zone of 40 within 2 cells; seen (or heard within 2 cells) after 4 to 8 ticks: a dash of up to 3 cells
    // when he can get 2.5 cells away in time, else prone. Carried: the assault 2, its LMG gunner 1, engineers 1 (grenadeCarry).
    "grenades": { "minRange": 15, "maxRange": 35, "proneRange": 25, "seenTicks": 40, "hitBelow": 300, "friendClear": 20, "squadCooldown":
      80, "throwTicks": 16, "flightTicks": 15, "fuseTicks": 50, "scatter": 5, "scatterRecruit": 10, "scatterElite": 3, "damage": 45,
      "radius": 20, "zone": 40, "zoneRadius": 20, "reflexMin": 4, "reflexMax": 8, "escape": 25, "dash": 30, "proneDamage": 50,
      "hearReach": 20, "lmgCarry": 1 },
    "grenadeCarry": { "assault": 2, "engineer_drone": 1, "engineer_sapper": 1 },
    // 5.5, 7.6: a friendly ground vehicle stopped or under 50% of its top speed is cover within 1 cell of its side away from the
    // threat (high: coverHighTags, else low), looked for within 2 cells; moving with one within 4 cells going the same way (goals
    // within 6 cells), up to 3 slots behind a high one, 2 behind a low one, 1 cell off the hull.
    "vehicleCover": { "speedPercent": 50, "side": 10, "scan": 20, "followReach": 40, "goalReach": 60, "slotsHigh": 3, "slotsLow": 2,
      "slotOffset": 10 },
    // INF-E1b-3, the squad think (rules 10, 11, 15.4 to 15.7, 16.2, 21): urgent squad thinks 20 a tick, calm after 5 s without a
    // contact; the enemy group within 4 cells of the main enemy, kept while within 80% of a new one's danger. 10.2's force values
    // (in range, beyond it to 1.5x; launchers and the Kornet against infantry and vehicles; a friendly vehicle within 6 cells) and
    // their factors; R from 10 to 1000, moving 30 a think. 10.3: a choice kept 40 ticks, thresholds passed back by 10; closed at
    // 70% of the line weapon's range; Advance at R 100 (attack-move), 150 (no order, guard); withdraw under 50 (part 2); an idle
    // advance 6 cells from its post; a goal off the axis by 9 steps is behind. 11.1: the line 2 cells apart (1.5 with 8 or more);
    // the box 2 cells along, 2 behind, 1 ahead; rebuilt after 3 cells, urgently 5 steps off; depths medic 2, RPG 1, support 6, air
    // guard 3. 11.3, 11.4: the base ready within 20 ticks; alternate bounds 3 to 5 cells, leapfrog 2 to 3 past at R 120; 1.5 cells
    // across; 90 ticks a bound; marching fire at R 150 after 40 quiet ticks, 2 cells a step. 11.6: suppressive under a 20% hit
    // chance, 50% ammo (the LMG 25%), landing within 1 cell, a quarter's hit chance on a man within 0.5 cells, dropped after 10 s,
    // lifted with a friend within 2 cells of the aim; the LMG's wait 10. 16.2: deploys in 1.5 s on a stop of 2 s, arc 4 steps a
    // side, a contact outside it 40 ticks (danger 10+) turns him (1 s). Part 2 (11.5): a flank after 120 ticks in Fight in place
    // with under 2 hits in two 60-tick windows, the enemy's mean protection 55+, 4 able, R 70; 2 flankers (3 from 7), 80% of their
    // range out, ways of at most 25 cells, over 40% exposed (10+) rejected; 20 ticks of suppression first, fire on the way only
    // within 3 cells; abort when the group moves 3 cells, 400 ticks before the next (a rejected plan 100), 300 ticks at most on
    // the way. 11.7: within 3 cells at R 120, 3 able, two thirds run; 2 grenades and a 2 s wait; fire shifts at 2 cells; ends
    // with no enemy within 3 cells; fails under R 80 or after 200 ticks, 200 before the next. gaits.riseMove: a kneeling man
    // who must move steps off at 60% while he stands up. 12 (part 3): an unordered withdrawal under R 50 (autoWithdrawBelow) to the
    // best cell 2 to 8 cells behind the line, 2 either side, worth it at 70% of the exposure here; elements step 2 to 3 cells back
    // (1.5 across, 60 ticks at most a step), two refused steps end it; no point found: 100 ticks before the next look. 18: 200
    // ticks of consolidation with no order or in Hold, Ambush or Guard, 60 under an Attack-move.
    "squad": {
      "urgentThinks": 20, "calmTicks": 100, "groupRadius": 40, "mainKeep": 80, "rifle": 10, "rifleOut": 3, "carbine": 8,
      "carbineOut": 2, "smg": 9, "smgOut": 1, "lmg": 22, "lmgDeployed": 28, "lmgOut": 6, "marksman": 14, "marksmanOut": 4,
      "launcher": 6, "launcherVehicle": 40, "pistol": 4, "kornet": 2, "kornetVehicle": 40, "vehicleReach": 60, "wounded": 75,
      "suppressed": 50, "pinnedHard": 20, "lowAmmo": 70, "empty": 30, "rankRegular": 105, "rankVeteran": 110, "rankElite": 115,
      "seenBefore": 80, "heard": 70, "area": 10, "ratioMin": 10, "ratioMax": 1000, "ratioStep": 30, "choiceHoldTicks": 40,
      "choiceHysteresis": 10, "advanceToPercent": 70, "advanceR": 100, "idleAdvanceR": 150, "guardAdvanceR": 150,
      "autoWithdrawBelow": 50, "postLeash": 60, "contactSpacing": 20, "minSpacing": 15, "manyOnLine": 8, "boxAlong": 20,
      "boxBehind": 20, "boxAhead": 10, "rebuildMoved": 30, "urgentSteps": 5, "medicBehind": 20, "flankBehind": 10,
      "supportBehind": 60, "airGuardBehind": 30, "readyTicks": 20, "boundMin": 30, "boundMax": 50, "leapMin": 20, "leapMax": 30,
      "leapR": 120, "boundAcross": 15, "boundMaxTicks": 90, "marchR": 150, "marchQuietTicks": 40, "marchStep": 20,
      "suppressHitBelow": 200, "suppressAmmoPercent": 50, "lmgSuppressAmmo": 25, "suppressSpread": 10, "suppressHitPercent": 25,
      "suppressHitNear": 5, "suppressLiftTicks": 200, "suppressAimClear": 20, "lmgWait": 10, "lmgDeployTicks": 30,
      "lmgStopTicks": 40, "lmgArcSteps": 4, "lmgOutTicks": 40, "lmgRedeployTicks": 20,
      "flankFipTicks": 120, "flankWindowTicks": 60, "flankHitsBelow": 2, "flankCoverAvg": 55, "flankMinAble": 4,
      "flankMinR": 70, "autoFlank": 1, "flankBigSquad": 7, "flankDistancePercent": 80, "flankMaxPath": 250,
      "flankExposed": 1000, "flankMaxExposed": 40, "flankSuppressTicks": 20, "flankCloseFire": 30, "flankMoved": 30,
      "flankRetryTicks": 400, "flankRejectTicks": 100, "flankMaxTicks": 300, "assaultRange": 30, "assaultR": 120,
      "assaultMinAble": 3, "assaultShare": 667, "assaultGrenades": 2, "assaultGrenadeWait": 40, "assaultShiftRange": 20,
      "assaultEndRange": 30, "assaultFailR": 80, "assaultMaxTicks": 200, "assaultRetryTicks": 200,
      "withdrawStepMin": 20, "withdrawStepMax": 30, "withdrawAcross": 15, "withdrawStepTicks": 60, "withdrawReach": 80,
      "withdrawWidth": 20, "withdrawGainPercent": 70, "withdrawRefusals": 2, "withdrawRetryTicks": 100, "consolidateTicks": 200,
      "consolidateOrderTicks": 60, "withdrawRescueWaitTicks": 60, "moveBehindSteps": 9, "longFlankBehind": 40 },
    "coverHighTags": ["tank", "heavy"], "coverLowTags": ["vehicle"],
    // 21: soldier thinks every 5 ticks in contact, 20 out of it, on the ID's phase; squads every 10; at most 40 urgent thinks a
    // tick.
    "morale": { "start": 80, "killed": 15, "down": 8, "wounded": 5, "leader": 20, "leaderPauseTicks": 200, "pinnedTicks": 160, "pinnedRate": 2, "flanked": 10, "flankedTicks": 200, "vehicleReach": 80, "vehicleRate": 1,
      "enemyKilled": 5, "quietTicks": 100, "quietRate": 3, "aidReach": 60, "aidRate": 1, "garrisonRate": 1, "steadyAt": 50, "brokenBelow": 20, "rally": 40, "rallyLed": 35, "routBelow": 10, "routEnd": 20,
      "shakenAim": 90, "brokenAim": 70, "shakenSuppress": 120, "brokenSuppress": 140, "shakenReact": 2, "brokenReact": 4, "shakenH": 80, "shakenForce": 90, "brokenForce": 60, "brokenFireRange": 30, "firedOnTicks": 40, "safeReach": 300 },
    // 13: calls for support: urgency U, matching every second, helpers (rules 13.1 to 13.4; distances in tenths of a cell).
    "calls": { "uContact": 30, "uRatio": 20, "uRatioLow": 20, "uPinned": 20, "uLoss": 10, "uLossMax": 30, "lossTicks": 400, "uArmour": 20, "uFlankRefused": 10, 
      "uGarrison": 10, "withdrawTicks": 200, "matchEvery": 20, "needPercent": 130, "callRadius": 250, "maxHelpers": 2, "releaseTicks": 600, 
      "supportNear": 100, "otherFight": 150, "minAmmo": 50, "minAble": 2, "supportSteps": 4, "approachPercent": 150, "helpArrived": 5, "arrivedReach": 100, 
      "standDownTicks": 200, "autoSupport": 1, "lineSideMin": 40, "lineSideMax": 60 },
    // INF-E1b-4 part 3: 14.4 (the first impact of indirect fire within 6 cells marks the squad: its men keep 2 cells apart while it
    // lasts; an air attack run seen within 10 cells: men in the open go prone for 10 s and the squad spreads to 2 cells); 12.4 (a routing
    // man fired on from within 3 cells who can't run, pinned hard at 90+ or with no way, drops prone and stops firing; part 4: a loose
    // routing man runs to a building or his side's structure, cornered only with an enemy within 2 cells or no way out).
    "reactions": { "impactNear": 60, "fireSpacing": 20, "airNear": 100, "airTicks": 200, "cornerReach": 30, "cornerPinned": 90, "looseCorner": 20 },
    "think": { "soldierEvery": 5, "soldierCalmEvery": 20, "squadEvery": 10, "urgentThinks": 40 }
  }
}
