{
  // The damage table from docs/design.md ("Combat rules"): percent of a
  // weapon's damage dealt to each armor class; null means the warhead cannot
  // target that class at all.
  // armored_vehicle: the infantry carrier, an armoured troop truck built to live through any single
  // strike but the tactical ballistic missile and a full heavy rocket salvo (see its archetype).
  // parked_aircraft: an aircraft on the ground at an airfield (its aircraft block's groundArmor, from
  // touchdown to wheels-up): a thin airframe full of fuel. Never an attack target there, it takes the
  // splash of every ground warhead, a little more than a light vehicle (bullets 60%, rockets and
  // missiles 100-133%, the mortar's fragments 80%); AA missiles never reach it (air defence leaves
  // grounded aircraft alone). In the air it keeps its own armor (drone).
  // aircraft: a jet in the air (E8). No ground warhead reaches a flying unit (no weapon may target
  // one; air defence's own kill model decides its missiles), so the column copies the drone's; the
  // jets' gun (air_gun) is what tells them apart: a drone dies to one burst, a jet takes several.
  // Bullets: 100% against a jet in the air (E10): only the technical's heavy MG reaches one, below
  // 40 m (decision D5; its airGun block).
  "armorClasses": ["infantry", "light_vehicle", "building", "drone", "medium_vehicle", "armored_vehicle", "parked_aircraft", "aircraft"],
  "warheads": [
    { "id": "bullet",       "versus": { "infantry": 100,  "light_vehicle": 40,   "building": 10,   "drone": 15, "medium_vehicle": 40, "armored_vehicle": 20, "parked_aircraft": 60, "aircraft": 100 } },
    { "id": "sniper_round", "versus": { "infantry": 150,  "light_vehicle": 20,   "building": 5,    "drone": 15, "medium_vehicle": 20, "armored_vehicle": 10, "parked_aircraft": 30, "aircraft": 15 } },
    { "id": "rocket",       "versus": { "infantry": 40,   "light_vehicle": 120,  "building": 80,   "drone": null, "medium_vehicle": 120, "armored_vehicle": 120, "parked_aircraft": 120, "aircraft": null } },
    // The rocket truck's 30-tube rockets: the rocket's table with 68% more against infantry and
    // about 11% more against vehicles (a direct hit takes 150 of a technical's 180: two kill it).
    { "id": "mrl_rocket",   "versus": { "infantry": 67,   "light_vehicle": 133,  "building": 80,   "drone": null, "medium_vehicle": 133, "armored_vehicle": 35, "parked_aircraft": 133, "aircraft": null } },
    { "id": "explosive",    "versus": { "infantry": 100,  "light_vehicle": 100,  "building": 60,   "drone": null, "medium_vehicle": 100, "armored_vehicle": 100, "parked_aircraft": 120, "aircraft": null } },
    // The heavy rocket truck's big rockets: double damage to buildings (3 hits bring down a panel block).
    { "id": "heavy_rocket", "versus": { "infantry": 100,  "light_vehicle": 100,  "building": 200,  "drone": null, "medium_vehicle": 100, "armored_vehicle": 120, "parked_aircraft": 120, "aircraft": null } },
    // The twin missile truck's missiles: 220% to buildings (2 hits bring down a panel block).
    { "id": "heavy_missile", "versus": { "infantry": 100,  "light_vehicle": 100,  "building": 220,  "drone": null, "medium_vehicle": 100, "armored_vehicle": 100, "parked_aircraft": 120, "aircraft": null } },
    // The tactical ballistic missile: the heavy missile's table (it already hits 1.3x harder), plus
    // 170% against armour: a near-vertical, very fast heavy warhead, the one strike that destroys an
    // infantry carrier outright (730 x 170% = 1241 of its 1200 HP) when it lands inside the inner ring.
    { "id": "ballistic",    "versus": { "infantry": 100,  "light_vehicle": 100,  "building": 220,  "drone": null, "medium_vehicle": 100, "armored_vehicle": 170, "parked_aircraft": 120, "aircraft": null } },
    // The Kornet's guided anti-tank missile: about 70% of a technical per hit, about 30% of a
    // launcher (medium_vehicle), barely hurts infantry, and a building takes what an RPG hit does
    // (126 x 45% = 56, the RPG's 70 x 80%).
    { "id": "atgm",         "versus": { "infantry": 15,   "light_vehicle": 100,  "building": 45,   "drone": null, "medium_vehicle": 55, "armored_vehicle": 100, "parked_aircraft": 100, "aircraft": null } },
    // A one-way attack drone's 40 kg charge: kills infantry, wrecks most vehicles, and on a building
    // takes exactly 20% of its max HP a hit whatever its size (5 drones bring any down).
    { "id": "drone_charge", "versus": { "infantry": 100,  "light_vehicle": 100,  "building": 100,  "drone": null, "medium_vehicle": 100, "armored_vehicle": 100, "parked_aircraft": 100, "aircraft": null },
      "maxHpPercent": { "building": 20 } },
    // The anti-personnel mine's blast (docs/design.md, "Traps"): full effect on soldiers, a scratch on
    // vehicles (120 x 10% = 12 at the centre to a technical's 180).
    // The Kaman drone's dive warhead (a Kaman-22 type's, about twice a one-way drone's): kills infantry and every
    // vehicle near it, armour included (250%: 520 x 250% = 1300 on a direct hit, over the infantry carrier's 1200), and
    // on a building takes 45% of its max HP a hit whatever its size (the one-way drone: 20%).
    { "id": "kaman_charge", "versus": { "infantry": 100,  "light_vehicle": 100,  "building": 100,  "drone": null, "medium_vehicle": 100, "armored_vehicle": 250, "parked_aircraft": 120, "aircraft": null },
      "maxHpPercent": { "building": 45 } },
    { "id": "ap_blast",     "versus": { "infantry": 100,  "light_vehicle": 10,   "building": 5,    "drone": null, "medium_vehicle": 10, "armored_vehicle": 2, "parked_aircraft": 40, "aircraft": null } },
    // The anti-tank mine's blast around the vehicle it destroys (that one is destroyed outright: the
    // trigger's kills): hurts what stands next to it, never kills a second vehicle.
    { "id": "at_blast",     "versus": { "infantry": 100,  "light_vehicle": 100,  "building": 30,   "drone": null, "medium_vehicle": 100, "armored_vehicle": 25, "parked_aircraft": 100, "aircraft": null } },
    // The mortar soldier's bomb (docs/design.md, "Mortar"): full effect on soldiers (a direct hit, 90, kills
    // any of them), light against vehicles (40 of a technical's 180 or a rocket truck's 220: five or six
    // direct hits), a scratch on armour (9 of the carrier's 1200) and buildings (27).
    { "id": "mortar_bomb",  "versus": { "infantry": 100,  "light_vehicle": 45,   "building": 30,   "drone": null, "medium_vehicle": 45, "armored_vehicle": 10, "parked_aircraft": 80, "aircraft": null } },
    // The Watcher drone's air-to-ground missile (a Hellfire type; its outcome table is the weapon's
    // airStrike block: soldiers and vehicles hit are destroyed, heavy ones 80% of the time). This
    // table is for what it does not destroy outright: a building hit (600 x 120% = 720) and the
    // splash round the point (soldiers die, vehicles beside it are hurt, armour barely).
    { "id": "air_strike",   "versus": { "infantry": 100,  "light_vehicle": 60,   "building": 120,  "drone": null, "medium_vehicle": 60, "armored_vehicle": 25, "parked_aircraft": 100, "aircraft": null } },
    // The jets' bombs (E8; the plan's section 3.1): double damage to buildings (the 500 lb bomb's 700
    // takes 1,400: a brick block survives one at stage 3, two bring it down; the 2,000 lb's 1,300 takes
    // 2,600: a panel block falls), 60% against armour, 120% against a parked aircraft. Delivered by
    // the air-to-ground system (E7).
    { "id": "bomb",         "versus": { "infantry": 100,  "light_vehicle": 100,  "building": 200,  "drone": null, "medium_vehicle": 100, "armored_vehicle": 60, "parked_aircraft": 120, "aircraft": null } },
    // The stealth bomber's bunker buster (a GBU-57 type penetrator): full against everything on the ground, double against
    // buildings; its penetrator block then destroys whatever is still standing within its radius, whatever the armour.
    { "id": "bunker_buster", "versus": { "infantry": 100,  "light_vehicle": 100,  "building": 200,  "drone": null, "medium_vehicle": 100, "armored_vehicle": 100, "parked_aircraft": 100, "aircraft": null } },
    // The jets' gun (E8; bursts, fired by the air-to-air system, E6, and strafing, E7): a 90-damage
    // burst destroys a drone (400%: 360, more than any drone's HP), takes about a third of a jet (100%),
    // shreds soldiers and parked aircraft, 60% against light and medium vehicles, barely scratches
    // buildings (5%) and armour.
    { "id": "air_gun",      "versus": { "infantry": 100,  "light_vehicle": 60,   "building": 5,    "drone": 400, "medium_vehicle": 60, "armored_vehicle": 10, "parked_aircraft": 100, "aircraft": 100 } },
    // A crashing aircraft's impact (E10; decision D9b, night default: a small blast where the wreck
    // hits, 150 damage over 3 cells): a fuel fireball, hard on soldiers and light vehicles.
    { "id": "crash",        "versus": { "infantry": 100,  "light_vehicle": 100,  "building": 50,   "drone": null, "medium_vehicle": 100, "armored_vehicle": 50, "parked_aircraft": 100, "aircraft": null } },
    { "id": "aa_missile",   "versus": { "infantry": null, "light_vehicle": null, "building": null, "drone": 100, "medium_vehicle": null, "armored_vehicle": null, "parked_aircraft": null, "aircraft": 100 } },
    // The ground attack jet's heavy nose cannon (H2; a 30 mm type): armour-piercing bursts that hit vehicles
    // hard (70% against armour, the jets' gun 10%), shred soldiers and parked aircraft, scratch buildings; in
    // the air 40% against a jet (60 of a burst's 150) and its airGun's low hit chances: weak against aircraft.
    { "id": "heavy_cannon", "versus": { "infantry": 100,  "light_vehicle": 100,  "building": 15,   "drone": 400, "medium_vehicle": 100, "armored_vehicle": 70, "parked_aircraft": 120, "aircraft": 40 } },
    // The gunship's light side cannon (H3; a 40 mm type, fired from its orbit): high-explosive rounds that shred soldiers
    // and parked aircraft, hurt light and medium vehicles (80%: medium is the launchers' class, a truck like a light
    // vehicle for every warhead but the ATGM), barely scratch armour (15%) and buildings (10%). Ground only.
    { "id": "autocannon",   "versus": { "infantry": 100,  "light_vehicle": 80,   "building": 10,   "drone": null, "medium_vehicle": 80, "armored_vehicle": 15, "parked_aircraft": 100, "aircraft": null } },
    // The attack helicopter's 30 mm chin cannon (the helicopters night): good against soldiers, light vehicles and trucks, a
    // scratch on armour (25%) and buildings (15%). Ground only.
    { "id": "heli_cannon",  "versus": { "infantry": 100,  "light_vehicle": 100,  "building": 15,   "drone": null, "medium_vehicle": 100, "armored_vehicle": 25, "parked_aircraft": 100, "aircraft": null } },
    // The armoured helicopter's 30 mm cannon (high-explosive rounds): with its 10% lighter burst, about 30% more against
    // soldiers than the attack helicopter's (27 x 145% = 39 against 30) and a bit weaker against vehicles (27 against 30).
    { "id": "heli_cannon_he", "versus": { "infantry": 145, "light_vehicle": 100,  "building": 15,   "drone": null, "medium_vehicle": 100, "armored_vehicle": 25, "parked_aircraft": 100, "aircraft": null } },
    // The helicopters' anti-tank missile (a Hellfire type): deadly to every vehicle (full damage to trucks and armour), a
    // building takes 60%, soldiers barely (a direct hit still kills one; the splash is small).
    { "id": "heli_missile", "versus": { "infantry": 20,   "light_vehicle": 100,  "building": 60,   "drone": null, "medium_vehicle": 100, "armored_vehicle": 100, "parked_aircraft": 100, "aircraft": null } },
    // The Humvee's .50 cal (humvee_mg): the bullet's table with 125% against infantry (its anti-infantry edge), ground only.
    { "id": "heavy_bullet", "versus": { "infantry": 125,  "light_vehicle": 40,   "building": 10,   "drone": null, "medium_vehicle": 40, "armored_vehicle": 20, "parked_aircraft": 60, "aircraft": null } },
    // The tank's armour-piercing round (APFSDS, docs/design.md, "Main battle tank"): full damage to every vehicle (a 900 hit:
    // the infantry carrier in 2, any truck or the Humvee in 1, a tank head-on in 7 through its directional armour), a dart
    // that goes through a soldier or a wall (10%, 15%). The gun picks it against vehicles.
    { "id": "apfsds",       "versus": { "infantry": 10,   "light_vehicle": 100,  "building": 15,   "drone": null, "medium_vehicle": 100, "armored_vehicle": 100, "parked_aircraft": 100, "aircraft": null } },
    // The tank's high-explosive multipurpose round (HE/MPAT): soldiers and buildings (120%), trucks and cars; a quarter against armour.
    // The gun picks it against infantry and buildings.
    { "id": "he_mpat",      "versus": { "infantry": 100,  "light_vehicle": 100,  "building": 120,  "drone": null, "medium_vehicle": 100, "armored_vehicle": 25, "parked_aircraft": 120, "aircraft": null } }
  ]
}
