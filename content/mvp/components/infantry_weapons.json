{
  // range and splash in tenths of a cell; reload in ticks; projectileSpeed in
  // tenths of a cell per second (0 hits instantly). targets: the layers a
  // weapon can hit; its warhead must also be able to target the armor class. runway: the crater
  // a ground-attack missile digs in a runway (see vehicle_weapons.json).
  "components": [
    { "id": "rifle", "requires": ["infantry"], "cost": 10,
      "effects": [{ "weapon": { "damage": 12, "range": 50, "reload": 15, "warhead": "bullet", "targets": ["ground", "air"] } }] },
    { "id": "smg", "requires": ["infantry"], "cost": 10,
      "effects": [{ "weapon": { "damage": 7, "range": 35, "reload": 6, "warhead": "bullet", "targets": ["ground", "air"] } }] },
    { "id": "lmg", "requires": ["infantry"], "cost": 20,
      "effects": [{ "weapon": { "damage": 9, "range": 55, "reload": 5, "warhead": "bullet", "targets": ["ground", "air"] } }] },
    {
      // Placeholder: the real secondary list for assault and engineer is undecided.
      "id": "pistol", "placeholder": true, "requires": ["infantry"], "cost": 5,
      "effects": [{ "weapon": { "damage": 6, "range": 30, "reload": 12, "warhead": "bullet", "targets": ["ground", "air"] } }]
    },
    { "id": "short_rifle", "requires": ["infantry"], "cost": 10,
      "effects": [{ "weapon": { "damage": 10, "range": 40, "reload": 14, "warhead": "bullet", "targets": ["ground", "air"] } }] },
    { "id": "sniper_rifle", "requires": ["infantry"], "cost": 30,
      "effects": [{ "weapon": { "damage": 40, "range": 120, "reload": 60, "warhead": "sniper_round", "targets": ["ground", "air"] } }] },
    { "id": "at_missile", "requires": ["infantry"], "cost": 40,
      "effects": [{ "weapon": { "runway": { "crater": "small" }, "damage": 70, "range": 90, "reload": 70, "warhead": "rocket", "splash": 5,
                                "projectileSpeed": 200, "targets": ["ground"],
                                // On its own it only engages infantry within 4 cells and not running away,
                                // and gives up on a target after 3 misses in a row; vehicles come first.
                                "autoRange": { "infantry": 40 }, "autoSkipRetreating": true, "maxMisses": 3 } }] },
    {
      // The Kornet team's guided anti-tank missile: 1 s to aim before every shot (standing still),
      // guided by the operator up to 36 cells of flight (range 28.8 + 25%); it hits only its target. It
      // loses guidance when the operator moves, the target gets away or dies; then it drops.
      // Reload 5 s, from the moment it stops guiding. Vehicles first, then buildings, then infantry.
      "id": "kornet_atgm", "requires": ["infantry"], "cost": 120,
      "effects": [{ "weapon": { "runway": { "crater": "small" }, "damage": 126, "range": 288, "reload": 100, "warhead": "atgm",
                                "projectileSpeed": 200, "targets": ["ground"], "aimTicks": 20,
                                "guided": { "maxFlight": 360, "turnRate": 90, "requiresOperatorStill": true, "dropDistance": 30 },
                                "priority": ["light_vehicle", "medium_vehicle", "armored_vehicle", "building", "infantry"] } }] },
    {
      // The air defence soldier's Igla-style IR missile, against one-way attack drones only (the
      // "drone" interception class). Tracked 1.5 s (lockTicks) before he may fire; 140 cells of
      // slant range (8 minimum); it flies at 30 cells/s (2.5x the drone's cruise), turns at most
      // 45 degrees a second, and self-destructs after 180 cells. Lead pursuit: it steers at where the
      // drone will be, up to 4 s ahead (leadTicks). A 3 m proximity fuse, then a kill
      // roll: 78% tail-on, 42% head-on, less for a fast target, a fast crossing at launch and a long
      // shot, more for a long track. 5 missiles (1 loaded + 4 spare), 4 s to load the next; only a
      // supply depot refills them, 5 s and 60 supply a missile. It also engages the scout drone
      // ("scout" class), but every chance against it is scaled so the best shot is 5% (killBest), and
      // the Watcher strike drone ("watcher": 10% at best, 150 m up near the top of its reach). The
      // Overseer surveillance drone ("overseer", 250 m up: in reach only within about 63 cells of the
      // point under it) takes a flat hit roll instead (hits): 45%, and a hit takes 55% of its HP.
      // E5 (air classes as content): an IR seeker (flares decoy it, E6); against the jets ("multirole",
      // "fighter") 35% at best, judged against their attack speed instead of a drone's (speedRefs), and a
      // hit takes 60% of a jet's HP (hitDamage: a damaged jet can limp home); the FPV drone ("fpv") 70%
      // at best once it flies as an air target (E6). The air superiority jet's signature lowers its own.
      "id": "igla", "requires": ["infantry"], "cost": 60,
      "effects": [{ "weapon": { "damage": 100, "range": 1400, "minRange": 80, "reload": 80, "warhead": "aa_missile",
                                "projectileSpeed": 300, "targets": ["air"], "ammo": 5, "ammoPerRocket": true,
                                "depotReload": { "everyTicks": 100, "afterFireTicks": 20, "cost": 60 },
                                "guided": { "maxFlight": 1800, "turnRate": 45 },
                                "intercept": { "classes": ["drone", "scout", "watcher", "overseer", "fpv", "multirole", "fighter"], "seeker": "ir",
                                               "killBest": { "scout": 5, "watcher": 10, "fpv": 70, "multirole": 35, "fighter": 35 },
                                               "speedRefs": { "multirole": 230, "fighter": 240 }, "hitDamage": { "multirole": 60, "fighter": 60 },
                                               "hits": { "overseer": { "chance": 45, "damage": 55 } }, "lockTicks": 30, "fuse": 15, "killTail": 78, "killHead": 42,
                                               "crossHalf": 600, "speedRef": 120, "rangeFar": 70, "trackBonus": 25, "trackFull": 100,
                                               "killMin": 5, "killMax": 95, "leadTicks": 80 } } }] },
    {
      // The mortar soldier's light mortar (docs/design.md, "Mortar"): indirect fire on a high arc (its apex
      // 45% of the distance up, so it clears ridges and woods) from 8 to 30 cells: half the rocket
      // truck's 60, beyond every other infantry weapon. 1 s to lay the tube before every round (aimTicks,
      // standing still) plus 3 s between rounds: one round every 4 s. 90 damage (the mortar_bomb warhead:
      // 90 to soldiers, 40 to a technical), a 2.5-cell splash from 100% at the centre to 20% at its edge.
      // Scatter grows with the distance, about a tenth of it: 0.8 cell per axis at 8 cells (scatterNear),
      // 3 cells at 30. The round flies at 8 cells/s (3.75 s to full range). A pack of 10 bombs; only a
      // supply depot refills it: one every 2 s, for 10 supply each, starting 5 s after the last round
      // (longer than the 4 s between rounds, so a mortar firing at a depot still runs dry and pauses).
      "id": "mortar_tube", "requires": ["infantry"], "cost": 60,
      "effects": [{ "weapon": { "damage": 90, "range": 300, "minRange": 80, "reload": 60, "aimTicks": 20, "warhead": "mortar_bomb",
                                "splash": 25, "splashCenter": 100, "splashEdge": 20, "scatter": 30, "scatterNear": 8,
                                "projectileSpeed": 80, "arc": 45, "targets": ["ground"], "ammo": 10, "ammoPerRocket": true,
                                "depotReload": { "everyTicks": 40, "afterFireTicks": 100, "cost": 10 } } }] },
    { "id": "aa_missile", "requires": ["infantry"], "cost": 40,
      "effects": [{ "weapon": { "damage": 60, "range": 80, "reload": 50, "warhead": "aa_missile", "targets": ["air"] } }] }
  ]
}
