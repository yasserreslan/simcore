      "effects": [{ "weapon": { "damage": 30, "range": 200, "reload": 10, "warhead": "heli_cannon", "splash": 8, "splashEdge": 50, "scatter": 8,
                                "targets": ["ground"], "ammo": 60, "noResupply": true, "cone": 110 } }] },
    // The armoured helicopter's 30 mm cannon (a 2A42 type, high-explosive rounds): a 10% lighter burst (27) through
    // heli_cannon_he (soldiers 145%: 39 a burst, about 30% more than the attack helicopter's; vehicles a bit less), a
    // wider splash (1.2 cells). A turret, 60 bursts.
    { "id": "heli_cannon_he", "requires": ["helicopter"],
      "effects": [{ "weapon": { "damage": 27, "range": 200, "reload": 10, "warhead": "heli_cannon_he", "splash": 12, "splashEdge": 50, "scatter": 8,
                                "targets": ["ground"], "ammo": 60, "noResupply": true, "cone": 110 } }] },
    // The attack helicopter's 10 anti-tank missiles (a Hellfire Longbow type, fire and forget; HB, the helicopter balance,
