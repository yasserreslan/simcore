{
  // The Sentinel faction's own components (docs/design.md, "Sentinel faction").
  "components": [
    // The assault medic's aid bag (sentinel_medic; the aura system, docs/design.md, "Assault medic"): every 1.5 s he
    // heals 3 HP to each of his side's people on foot (tag "infantry": soldiers, workers, a downed pilot) within 6 cells,
    // never above max HP: 2 HP a second, a half-dead rifleman (30 of 60) whole again in 15 s. Not vehicles or
    // structures (no "infantry" tag), not himself (another medic heals him), not anyone inside a vehicle or a building.
    // No stacking: a unit takes at most one aura heal per interval however many medics stand near (the strongest).
    { "id": "medic_kit", "requires": ["infantry"], "cost": 50,
      "effects": [{ "aura": { "heal": 3, "everyTicks": 30, "radius": 60, "affects": { "relation": "ally", "tags": ["infantry"] } } }] },
    // The Watcher's two Hellfire-type missiles (airStrike; the watcher system). Fired on orders only,
    // at an enemy ground unit within 35 cells of the point under the drone (its own sight), one every
    // 3 s, from 150 m up, at 40 cells/s along a straight line (about 2.5 s). The hit is rolled at
    // launch: 100% against a target that stood still, 80% against a moving one. A hit destroys
    // soldiers and every vehicle outright, except heavy ones (tag "heavy": the 30-tube rocket truck,
    // the heavy rocket truck, the twin missile truck, the ballistic missile truck, the infantry
    // carrier), which it destroys 80% of the time, else leaves at 25% of their HP; a building takes
    // 600 x 120% = 720 (30% of a panel block, 60% of the station itself). The 2.5-cell splash
    // (600 at the centre to 25% at the edge) kills soldiers round the point. A miss goes off on the
    // ground 4 to 7 cells from the target, out of reach of it. Nothing refills them in flight; the
    // drone flies home empty and its station rearms it.
    { "id": "watcher_missiles", "requires": ["drone"],
      "effects": [{ "weapon": { "runway": { "crater": "small" }, "damage": 600, "range": 350, "reload": 60, "warhead": "air_strike",
                                "splash": 25, "splashCenter": 100, "splashEdge": 25,
                                "projectileSpeed": 400, "targets": ["ground"], "ammo": 2, "ammoPerRocket": true, "noResupply": true,
                                "airStrike": { "hitIdle": 100, "hitMoving": 80, "kills": ["infantry", "vehicle"],
                                               "heavyTags": ["heavy"], "heavyKill": 80, "heavyHpLeft": 25,
                                               "missNear": 40, "missFar": 70 } } }] },
    // The Watcher control station's one Watcher (its only launch), aloft one at a time, launched at a
    // point anywhere (range); a drone that comes home is the station's again (and relaunched, see the drone). A
    // Watcher lost is replaced only at a supply depot, 60 s and 800 supply, never while one is aloft.
    { "id": "watcher_launch", "requires": [],
      "effects": [{ "launch": { "archetype": "watcher_drone", "charges": 1, "cooldown": 40, "range": 20000, "maxActive": 1,
                                "depotReload": { "everyTicks": 1200, "afterFireTicks": 0, "cost": 800 } } }] },
    // The Overseer control station's one Overseer (its only launch), the Watcher's way: aloft one at
    // a time, launched at a point anywhere; recovered, refuelled and relaunched by the station. An Overseer lost is replaced only at a supply depot, 45 s and 600 supply.
    { "id": "overseer_launch", "requires": [],
      "effects": [{ "launch": { "archetype": "overseer_drone", "charges": 1, "cooldown": 40, "range": 20000, "maxActive": 1,
                                "depotReload": { "everyTicks": 900, "afterFireTicks": 0, "cost": 600 } } }] },

    // ---- The jets' weapons (E8; the plan's section 3.1). Content now: the air-to-air system (E6)
    // fires the missiles and the gun at aircraft, the air-to-ground system (E7) drops the bombs and
    // strafes. Until then a jet carries them (stocks, rearmed at an airfield's stations) but fires
    // nothing: combat skips flying units and air defence skips flying shooters. Nothing but a
    // station's rearm refills them (noResupply). The bombs' damage gives the airstrike tier the
    // client draws (the plan's section 6.3): the glide bomb 350 (T2), 500 lb 700 (T4), 2,000 lb 1,300 (T6).
    //
    // The air superiority jet's long-range radar missile: 6, out to 110 cells (6 minimum), 60
    // cells/s, 35 degrees a second, a 1 s lock, a 60-degree launch cone (boresight); chaff decoys it.
    // Best shots: one-way drones 95, the FPV drone 90, the scout drone 75, the Watcher 85, the
    // Overseer 90, jets 70 (before their signature); a hit kills.
    { "id": "aam_radar", "requires": ["jet"],
      "effects": [{ "weapon": { "damage": 100, "range": 1100, "minRange": 60, "reload": 20, "warhead": "aa_missile",
                                "projectileSpeed": 600, "targets": ["air"], "ammo": 6, "ammoPerRocket": true, "noResupply": true,
                                "guided": { "maxFlight": 1500, "turnRate": 35 },
                                "intercept": { "classes": ["drone", "scout", "watcher", "overseer", "fpv", "multirole", "fighter", "attacker", "gunship", "bomber"], "seeker": "radar", "boresight": 60,
                                               "killBest": { "scout": 75, "watcher": 85, "overseer": 90, "fpv": 90, "multirole": 70, "fighter": 70, "attacker": 80, "gunship": 85, "bomber": 85 },
                                               "hitDamage": { "gunship": 13, "bomber": 17 },
                                               "lockTicks": 20, "fuse": 20, "killTail": 95, "killHead": 85, "crossHalf": 1500, "speedRef": 300,
                                               "rangeFar": 70, "trackBonus": 10, "trackFull": 100, "killMin": 10, "killMax": 95, "leadTicks": 80 } } }] },
    // Both jets' short-range IR missile (self-defence): 2, out to 40 cells (3 minimum), 55 cells/s,
    // 60 degrees a second, a 0.5 s lock, a 30-degree cone; flares decoy it. Best shots: one-way
    // drones 95, the FPV drone 90, the scout drone 60, the Watcher 75, the Overseer 80, jets 75.
    { "id": "aam_ir", "requires": ["jet"],
      "effects": [{ "weapon": { "damage": 100, "range": 400, "minRange": 30, "reload": 20, "warhead": "aa_missile",
                                "projectileSpeed": 550, "targets": ["air"], "ammo": 2, "ammoPerRocket": true, "noResupply": true,
                                "guided": { "maxFlight": 600, "turnRate": 60 },
                                "intercept": { "classes": ["drone", "scout", "watcher", "overseer", "fpv", "multirole", "fighter", "attacker", "gunship", "bomber"], "seeker": "ir", "boresight": 30,
                                               "killBest": { "scout": 60, "watcher": 75, "overseer": 80, "fpv": 90, "multirole": 75, "fighter": 75, "attacker": 80, "gunship": 85, "bomber": 85 },
                                               "hitDamage": { "gunship": 13, "bomber": 17 },
                                               "lockTicks": 10, "fuse": 15, "killTail": 92, "killHead": 60, "crossHalf": 1200, "speedRef": 300,
                                               "rangeFar": 70, "trackBonus": 15, "trackFull": 60, "killMin": 10, "killMax": 95, "leadTicks": 60 } } }] },
    // The jets' gun: one burst a second (a round of ammunition), out to 15 cells (E13, D-PUR1: 9 before; room
    // to shoot and still break off 6 cells out instead of flying through the target), 90 damage through the
    // air_gun warhead (a drone dies to one burst, a jet takes about four). The air superiority jet
    // carries 10 bursts, the multirole 8. Fired within a 10-degree cone of the nose (E6), or
    // strafing (E7). A burst's best hit chance by class (airGun.hitBase): one-way and FPV drones 85,
    // the scout drone 70, the Watcher 50, the Overseer 60, the multirole 30, the air superiority jet 25
    // (before its signature), halved by a 600 mrad/s crossing, 50% left at full range. Strafing (E7):
    // fire opens 18 cells out (slant), a burst every quarter second, each landing as a 1-cell splash
    // (splash 10) at a point that walks across the target (about 4 bursts a pass).
    { "id": "fighter_gun", "requires": ["jet"],
      "effects": [{ "weapon": { "damage": 90, "range": 150, "reload": 20, "warhead": "air_gun", "targets": ["air", "ground"], "splash": 10,
                                "ammo": 10, "ammoPerRocket": true, "noResupply": true,
                                "airGun": { "cone": 10, "hitBase": { "drone": 85, "fpv": 85, "scout": 70, "watcher": 50, "overseer": 60, "multirole": 30, "fighter": 25, "attacker": 55, "gunship": 60, "bomber": 60 },
                                            "crossHalf": 600, "rangeFar": 50, "strafeRange": 180, "strafeEvery": 5 } } }] },
    { "id": "multirole_gun", "requires": ["jet"],
      "effects": [{ "weapon": { "damage": 90, "range": 150, "reload": 20, "warhead": "air_gun", "targets": ["air", "ground"], "splash": 10,
                                "ammo": 8, "ammoPerRocket": true, "noResupply": true,
                                "airGun": { "cone": 10, "hitBase": { "drone": 85, "fpv": 85, "scout": 70, "watcher": 50, "overseer": 60, "multirole": 30, "fighter": 25, "attacker": 55, "gunship": 60, "bomber": 60 },
                                            "crossHalf": 600, "rangeFar": 50, "strafeRange": 180, "strafeEvery": 5 } } }] },
    // The air superiority jet's two small precision glide bombs (250 lb class): 350 damage through
    // the bomb warhead (700 to a building), a 3-cell splash from 100% at the centre to 25% at its
    // edge; released level from 70 m up to 50 cells out, guided (hit 95% on a target that stood still,
    // 75% on one that moved, a miss 3 to 5 cells off: the delivery block, E7); a small runway crater.
    { "id": "glide_bombs", "requires": ["jet"],
      "effects": [{ "weapon": { "runway": { "crater": "small" }, "damage": 350, "range": 500, "reload": 20, "warhead": "bomb",
                                "splash": 30, "splashCenter": 100, "splashEdge": 25, "projectileSpeed": 200, "targets": ["ground"],
                                "ammo": 2, "ammoPerRocket": true, "noResupply": true,
                                "delivery": { "profile": "level", "releaseHeight": 700,
                                              "guided": { "hitIdle": 95, "hitMoving": 75, "missNear": 30, "missFar": 50 } } } }] },
    // The multirole's loadouts (decision D18: two presets). Preset A: 4 x 500 lb general-purpose
    // bombs (Mk 82 type): 700 damage (1,400 to a building), two rings (100% within 2 cells, 30% out to
    // 5), dived on by default from a 16-cell initial point at 35 degrees, released 60 m up, 1.0 cell
    // of scatter in a dive (1.5 level, 3.0 tossed: the delivery block, E7), a small runway crater. A
    // free-fall bomb falls at the game's bomb gravity (gravity 700: 70 m/s^2, compressed like the jets'
    // speeds, so a dive released at 60 m lands about 19 cells on, a level drop about 26).
    { "id": "bombs_500lb", "requires": ["jet"],
      "effects": [{ "weapon": { "runway": { "crater": "small" }, "damage": 700, "range": 300, "reload": 10, "warhead": "bomb",
                                "splash": 50, "splashInner": 20, "splashCenter": 100, "splashOuterPercent": 30,
                                "projectileSpeed": 200, "targets": ["ground"], "ammo": 4, "ammoPerRocket": true, "noResupply": true,
                                "delivery": { "profile": "dive", "releaseHeight": 600, "diveAngle": 35, "tossAngle": 30, "ipDistance": 160,
                                              "scatterLevel": 15, "scatterDive": 10, "scatterToss": 30, "gravity": 700 } } }] },
    // Preset B: 2 x 2,000 lb general-purpose bombs (Mk 84 type): 1,300 damage (2,600 to a building),
    // two rings (100% within 3 cells, 30% out to 8), the same delivery, a large runway crater.
    { "id": "bombs_2000lb", "requires": ["jet"],
      "effects": [{ "weapon": { "runway": { "crater": "large" }, "damage": 1300, "range": 300, "reload": 20, "warhead": "bomb",
                                "splash": 80, "splashInner": 30, "splashCenter": 100, "splashOuterPercent": 30,
                                "projectileSpeed": 200, "targets": ["ground"], "ammo": 2, "ammoPerRocket": true, "noResupply": true,
                                "delivery": { "profile": "dive", "releaseHeight": 600, "diveAngle": 35, "tossAngle": 30, "ipDistance": 160,
                                              "scatterLevel": 15, "scatterDive": 10, "scatterToss": 30, "gravity": 700 } } }] },
    // ---- The ground attack jet's weapons (H2; the game repo's docs/heavy-air-plan.md, section 1.1). ----
    //
    // Its 8 heavy bombs (the owner's numbers): the 2,000 lb bomb's 1,300 damage (airstrike tier 6, the 2,000 lb
    // look; 2,600 to a building through the bomb warhead) with a 1.5x blast: 100% within 4.5 cells, 30% out to 12
    // (the 2,000 lb's 3 / 8), a large runway crater. Released from the wing pylons while it passes over the target:
    // a level run 40 m up, the bombs high-drag (retarded: they lose about 55% of their speed a second), so each
    // lands about 11 cells ahead of where it left (a 20-cell fall slick), almost under the jet. Two fire modes (modes; the card's
    // setting, CommandKind.SetFireMode): "single", one bomb a pass at each aim point (the default: the owner's first),
    // or "salvo4", a stick of 4 along its path, 4 cells apart (12 cells end to end), centred on the aim point.
    // Shift-queued aim points within 12 cells (group: a stick's length) of a pass's first one, along its line and
    // at most 3 cells off it (groupAside), are bombed in the same pass; an AttackLine spreads a pass's bombs evenly
    // from end to end. Only a station's rearm refills them.
    { "id": "heavy_bombs", "requires": ["jet"],
      "effects": [{ "weapon": { "runway": { "crater": "large" }, "damage": 1300, "range": 300, "reload": 10, "warhead": "bomb",
                                "splash": 120, "splashInner": 45, "splashCenter": 100, "splashOuterPercent": 30,
                                "projectileSpeed": 200, "targets": ["ground"], "ammo": 8, "ammoPerRocket": true, "noResupply": true,
                                "delivery": { "profile": "level", "releaseHeight": 400, "ipDistance": 120,
                                              "scatterLevel": 10, "scatterDive": 10, "scatterToss": 30, "gravity": 700, "retard": 80,
                                              "stickSpacing": 40, "group": 120, "groupAside": 30,
                                              "modes": [ { "id": "single", "salvo": 1 }, { "id": "salvo4", "salvo": 4 } ] } } }] },
    // Its 2 IR air-to-air missiles for self-defence: a lighter variant of the jets' aam_ir (the same seeker, lock, speed
    // and cone, 30 cells instead of 40): the drones' chances as aam_ir's, but against jets 40 to 45% at best and a hit
    // takes 60% (a jet's, as an Igla's) or 50% (another attack jet) instead of a kill: it fights back, it does not win.
    { "id": "aam_ir_light", "requires": ["jet"],
      "effects": [{ "weapon": { "damage": 100, "range": 300, "minRange": 30, "reload": 20, "warhead": "aa_missile",
                                "projectileSpeed": 550, "targets": ["air"], "ammo": 2, "ammoPerRocket": true, "noResupply": true,
                                "guided": { "maxFlight": 500, "turnRate": 60 },
                                "intercept": { "classes": ["drone", "scout", "watcher", "overseer", "fpv", "multirole", "fighter", "attacker", "gunship", "bomber"], "seeker": "ir", "boresight": 30,
                                               "killBest": { "scout": 60, "watcher": 75, "overseer": 80, "fpv": 90, "multirole": 45, "fighter": 40, "attacker": 45, "gunship": 70, "bomber": 70 },
                                               "hitDamage": { "multirole": 60, "fighter": 60, "attacker": 50, "gunship": 13, "bomber": 17 },
                                               "lockTicks": 10, "fuse": 15, "killTail": 92, "killHead": 60, "crossHalf": 1200, "speedRef": 300,
                                               "rangeFar": 70, "trackBonus": 15, "trackFull": 60, "killMin": 10, "killMax": 95, "leadTicks": 60 } } }] },
    // Its heavy nose cannon (a 30 mm type): one burst a second (a round), 12 bursts, out to 15 cells (strafing
    // from 20), 150 damage through the heavy_cannon warhead (a technical takes 150 of 180; armour 70%) with a
    // 1.5-cell splash: it strafes ground targets hard. Against aircraft it is weak: a burst's best hit chance
    // (hitBase) is a third to a half of the jets' gun's (drones 50 to 60, jets 10 to 20), the same 10-degree cone.
    { "id": "attack_gun", "requires": ["jet"],
      "effects": [{ "weapon": { "damage": 150, "range": 150, "reload": 20, "warhead": "heavy_cannon", "targets": ["air", "ground"], "splash": 15,
                                "ammo": 12, "ammoPerRocket": true, "noResupply": true,
                                "airGun": { "cone": 10, "hitBase": { "drone": 60, "fpv": 50, "scout": 30, "watcher": 25, "overseer": 30, "multirole": 15, "fighter": 10, "attacker": 20, "gunship": 30, "bomber": 30 },
                                            "crossHalf": 600, "rangeFar": 50, "strafeRange": 200, "strafeEvery": 4 } } }] },

    // ---- The gunship's side cannons (H3; the game repo's docs/heavy-air-plan.md, section 1.2). ----
    // Fired only from its left-hand orbit round its area, sideways from the left side (the sideFire block, GunshipSystem.cs):
    // each round flies straight from the aircraft to its aim point (360 m up and 30 cells off: about 185 cells of slant) and
    // goes off there like a bomb. Inaccurate by design: every round is scattered per axis round its aim (seeded). Each
    // cannon fires on its own reload. Ground only, never resupplied in the field (a station's rearm refills them).
    // The light cannon (a 40 mm type): 100 rounds, one every 0.4 s (40 s of fire), 45 damage through the autocannon
    // warhead with a 1.5-cell splash (soldiers, light vehicles), scattered 3 cells; at soldiers and light and medium
    // vehicles (and parked aircraft) first; with nothing seen it fires at seeded points of an attack-ground area.
    { "id": "gunship_light", "requires": ["aircraft"],
      "effects": [{ "weapon": { "damage": 45, "range": 2400, "reload": 8, "warhead": "autocannon", "targets": ["ground"],
                                "splash": 15, "splashCenter": 100, "splashEdge": 30, "projectileSpeed": 2000,
                                "ammo": 100, "ammoPerRocket": true, "noResupply": true,
                                "sideFire": { "scatter": 30, "priority": ["infantry", "light_vehicle", "medium_vehicle", "parked_aircraft"],
                                              "areaFire": true } } }] },
    // The heavy cannon (a 105 mm howitzer type): 20 rounds, one every 2.5 s (50 s of fire), half the multirole's 500 lb
    // bomb: 350 damage through the bomb warhead (700 to a building), its two rings (100% within 2 cells, 30% out to 5) and
    // its small runway crater, and its look (tier 4, the 500 lb's); scattered 2.5 cells; at vehicles first, then
    // structures, parked aircraft and soldiers; area fire like the light cannon's.
    { "id": "gunship_heavy", "requires": ["aircraft"],
      "effects": [{ "weapon": { "runway": { "crater": "small" }, "damage": 350, "range": 2400, "reload": 50, "warhead": "bomb",
                                "splash": 50, "splashInner": 20, "splashCenter": 100, "splashOuterPercent": 30, "projectileSpeed": 1500, "targets": ["ground"],
                                "ammo": 20, "ammoPerRocket": true, "noResupply": true,
                                "sideFire": { "scatter": 25, "tier": 4,
                                              "priority": ["medium_vehicle", "armored_vehicle", "light_vehicle", "building", "parked_aircraft", "infantry"],
                                              "areaFire": true } } }] },
    // The very big round (one, the ground attack jet's heavy bomb in size): 1,300 damage through the bomb warhead
    // (2,600 to a building), its 1.5x blast (100% within 4.5 cells, 30% out to 12), its large runway crater and look
    // (tier 6); scattered 2 cells, slower (10 cells/s: about 2 s of flight). Kept for the biggest target its side sees in
    // the area, a structure or an armoured vehicle (the most max HP; the ordered unit when it is one): never area fire.
    { "id": "gunship_big", "requires": ["aircraft"],
      "effects": [{ "weapon": { "runway": { "crater": "large" }, "damage": 1300, "range": 2400, "reload": 40, "warhead": "bomb",
                                "splash": 120, "splashInner": 45, "splashCenter": 100, "splashOuterPercent": 30, "projectileSpeed": 1000, "targets": ["ground"],
                                "ammo": 1, "ammoPerRocket": true, "noResupply": true,
                                "sideFire": { "scatter": 20, "priority": ["building", "armored_vehicle"], "pick": "biggest" } } }] },

    // ---- The strategic bomber's bombs (H4; the game repo's docs/heavy-air-plan.md, section 1.3). ----
    // 20 very heavy bombs (the owner's numbers), airstrike tier 7: 2,000 damage (4,000 to a building through the bomb
    // warhead), 100% within 5 cells and 30% out to 13, a large runway crater. Slick bombs dropped level from altitude (400 m
    // up, its cruise: above the AA soldier's ceiling): each falls about 3.4 s and lands about 50 cells ahead of where it left,
    // so it is released well before the target; the bomber flies on down its run line over the drops before it breaks
    // (overfly). Scatter 1.5 cells. Two fire modes (the card's setting, CommandKind.SetFireMode): "carpet20", all 20 in one
    // stick along its path, 2.5 cells apart (47.5 cells end to end), centred on the aim point, or spread from end to end of a
    // dragged line or across the aims bombed together (spread; at least 2.5 cells apart: a shorter line or group is stretched
    // about its middle); the default (the owner: "all on target"); or "salvo4", sticks of 4 (7.5 cells) at each aim point,
    // as the attack jet's salvo. Shift-queued aims within 48 cells (group: the carpet's length) of a pass's first, along its
    // line and at most 3 cells off it, are bombed in the same pass. Only a station's rearm refills them.
    { "id": "strategic_bombs", "requires": ["aircraft"],
      "effects": [{ "weapon": { "runway": { "crater": "large" }, "damage": 2000, "range": 600, "reload": 4, "warhead": "bomb",
                                "splash": 130, "splashInner": 50, "splashCenter": 100, "splashOuterPercent": 30,
                                "projectileSpeed": 200, "targets": ["ground"], "ammo": 20, "ammoPerRocket": true, "noResupply": true,
                                "delivery": { "profile": "level", "releaseHeight": 4000, "ipDistance": 150,
                                              "scatterLevel": 15, "scatterDive": 15, "scatterToss": 30, "gravity": 700,
                                              "stickSpacing": 25, "group": 480, "groupAside": 30, "overfly": true,
                                              "modes": [ { "id": "carpet20", "salvo": 20, "spread": true }, { "id": "salvo4", "salvo": 4 } ] } } }] },

    // The pilot's compact rifle (a PDW type; E8, the plan's section 3.2): 8 damage, 4 cells, 0.6 s.
    { "id": "compact_rifle", "requires": ["infantry"], "cost": 0,
      "effects": [{ "weapon": { "damage": 8, "range": 40, "reload": 12, "warhead": "bullet", "targets": ["ground", "air"] } }] },

    // The bulldozer's builder: the worker's (worker_build, rate 100) with 2.5 cells of reach instead
    // of 1.5, since a vehicle keeps a cell clear of a footprint and could not reach a site's corner.
    { "id": "dozer_build", "requires": ["worker"],
      "effects": [{ "builder": { "rate": 100, "range": 25 } }] },

    // The missile defence launcher's interceptors (a Patriot type; the game repo's docs/patriot-design.md, owner 2026-10-21):
    // 4 in the box, one every 2.5 s, 15 to 280 cells, 90 cells/s, 320 cells of flight. No sensor of its own (radarLinked):
    // it fires only on a friendly radar's track (the radar truck, a radar site, the air base's radar) within its reach.
    // Base kill chance (killBest; the kill model's speed, crossing and range terms still apply): arced missiles 85%, heavy
    // rockets 65%, drones 50%, aircraft 40%, ballistic missiles 12% (two at each: salvo); arcing threats only when they will
    // come down within 15 cells of its side (defendRadius). A hit takes a third of a gunship and half a bomber. Only its
    // reload pad refills it (noResupply: no depot), all 4 in 10 s.
    { "id": "patriot_missiles", "requires": ["patriot"],
      "effects": [{ "weapon": { "damage": 100, "range": 2800, "minRange": 150, "reload": 50, "warhead": "aa_missile",
                                "projectileSpeed": 900, "targets": ["air"], "ammo": 4, "ammoPerRocket": true, "noResupply": true,
                                "guided": { "maxFlight": 3200, "turnRate": 90 },
                                "intercept": { "classes": ["ballistic", "missile", "rocket", "drone", "scout", "watcher", "overseer", "fpv",
                                                           "multirole", "fighter", "attacker", "gunship", "bomber"],
                                               "seeker": "radar", "radarLinked": true, "salvo": { "ballistic": 2 }, "defendRadius": 150,
                                               "killBest": { "ballistic": 12, "missile": 85, "rocket": 65, "drone": 50, "scout": 50, "watcher": 50,
                                                             "overseer": 50, "fpv": 50, "multirole": 40, "fighter": 40, "attacker": 40, "gunship": 40, "bomber": 40 },
                                               "speedRefs": { "ballistic": 260, "missile": 150, "rocket": 170, "multirole": 240, "fighter": 240,
                                                              "attacker": 180, "gunship": 130, "bomber": 150 },
                                               "hitDamage": { "gunship": 34, "bomber": 50 },
                                               "lockTicks": 20, "fuse": 25, "killTail": 95, "killHead": 95, "crossHalf": 3000, "speedRef": 120,
