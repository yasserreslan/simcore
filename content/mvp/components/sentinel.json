{
  // The Sentinel faction's own components (docs/design.md, "Sentinel faction").
  "components": [
    // The Watcher's two Hellfire-type missiles (airStrike; the watcher system). Fired on orders only,
    // at an enemy ground unit within 35 cells of the point under the drone (its own sight), one every
    // 3 s, from 150 m up, at 40 cells/s along a straight line (about 2.5 s). The hit is rolled at
    // launch: 100% against a target that stood still, 80% against a moving one. A hit destroys
    // soldiers and every vehicle outright, except heavy ones (tag "heavy": the 30-tube rocket truck,
    // the heavy rocket truck, the twin missile truck, the ballistic missile truck, the infantry
    // carrier), which it destroys 80% of the time, else leaves at 25% of their HP; a building takes
    // 600 x 120% = 720 (30% of a panel block, 60% of the station itself). The 2.5-cell splash
    // (600 at the centre to 25% at the edge) kills soldiers round the point. A miss goes off on the
    // ground 4 to 7 cells from the target, out of reach of it. Nothing refills them in flight; the
    // drone flies home empty and its station rearms it.
    { "id": "watcher_missiles", "requires": ["drone"],
      "effects": [{ "weapon": { "runway": { "crater": "small" }, "damage": 600, "range": 350, "reload": 60, "warhead": "air_strike",
                                "splash": 25, "splashCenter": 100, "splashEdge": 25,
                                "projectileSpeed": 400, "targets": ["ground"], "ammo": 2, "ammoPerRocket": true, "noResupply": true,
                                "airStrike": { "hitIdle": 100, "hitMoving": 80, "kills": ["infantry", "vehicle"],
                                               "heavyTags": ["heavy"], "heavyKill": 80, "heavyHpLeft": 25,
                                               "missNear": 40, "missFar": 70 } } }] },
    // The Watcher control station's one Watcher (its only launch), aloft one at a time, launched at a
    // point anywhere (range); a drone that comes home is the station's again (and relaunched, see the drone). A
    // Watcher lost is replaced only at a supply depot, 60 s and 800 supply, never while one is aloft.
    { "id": "watcher_launch", "requires": [],
      "effects": [{ "launch": { "archetype": "watcher_drone", "charges": 1, "cooldown": 40, "range": 20000, "maxActive": 1,
                                "depotReload": { "everyTicks": 1200, "afterFireTicks": 0, "cost": 800 } } }] },
    // The Overseer control station's one Overseer (its only launch), the Watcher's way: aloft one at
    // a time, launched at a point anywhere; recovered, refuelled and relaunched by the station. An Overseer lost is replaced only at a supply depot, 45 s and 600 supply.
    { "id": "overseer_launch", "requires": [],
      "effects": [{ "launch": { "archetype": "overseer_drone", "charges": 1, "cooldown": 40, "range": 20000, "maxActive": 1,
                                "depotReload": { "everyTicks": 900, "afterFireTicks": 0, "cost": 600 } } }] },

    // ---- The jets' weapons (E8; the plan's section 3.1). Content now: the air-to-air system (E6)
    // fires the missiles and the gun at aircraft, the air-to-ground system (E7) drops the bombs and
    // strafes. Until then a jet carries them (stocks, rearmed at an airfield's stations) but fires
    // nothing: combat skips flying units and air defence skips flying shooters. Nothing but a
    // station's rearm refills them (noResupply). The bombs' damage gives the airstrike tier the
    // client draws (the plan's section 6.3): the glide bomb 350 (T2), 500 lb 700 (T4), 2,000 lb 1,300 (T6).
    //
    // The air superiority jet's long-range radar missile: 6, out to 110 cells (6 minimum), 60
    // cells/s, 35 degrees a second, a 1 s lock, a 60-degree launch cone (boresight); chaff decoys it.
    // Best shots: one-way drones 95, the FPV drone 90, the scout drone 75, the Watcher 85, the
    // Overseer 90, jets 70 (before their signature); a hit kills.
    { "id": "aam_radar", "requires": ["jet"],
      "effects": [{ "weapon": { "damage": 100, "range": 1100, "minRange": 60, "reload": 20, "warhead": "aa_missile",
                                "projectileSpeed": 600, "targets": ["air"], "ammo": 6, "ammoPerRocket": true, "noResupply": true,
                                "guided": { "maxFlight": 1500, "turnRate": 35 },
                                "intercept": { "classes": ["drone", "scout", "watcher", "overseer", "fpv", "multirole", "fighter"], "seeker": "radar", "boresight": 60,
                                               "killBest": { "scout": 75, "watcher": 85, "overseer": 90, "fpv": 90, "multirole": 70, "fighter": 70 },
                                               "lockTicks": 20, "fuse": 20, "killTail": 95, "killHead": 85, "crossHalf": 1500, "speedRef": 300,
                                               "rangeFar": 70, "trackBonus": 10, "trackFull": 100, "killMin": 10, "killMax": 95, "leadTicks": 80 } } }] },
    // Both jets' short-range IR missile (self-defence): 2, out to 40 cells (3 minimum), 55 cells/s,
    // 60 degrees a second, a 0.5 s lock, a 30-degree cone; flares decoy it. Best shots: one-way
    // drones 95, the FPV drone 90, the scout drone 60, the Watcher 75, the Overseer 80, jets 75.
    { "id": "aam_ir", "requires": ["jet"],
      "effects": [{ "weapon": { "damage": 100, "range": 400, "minRange": 30, "reload": 20, "warhead": "aa_missile",
                                "projectileSpeed": 550, "targets": ["air"], "ammo": 2, "ammoPerRocket": true, "noResupply": true,
                                "guided": { "maxFlight": 600, "turnRate": 60 },
                                "intercept": { "classes": ["drone", "scout", "watcher", "overseer", "fpv", "multirole", "fighter"], "seeker": "ir", "boresight": 30,
                                               "killBest": { "scout": 60, "watcher": 75, "overseer": 80, "fpv": 90, "multirole": 75, "fighter": 75 },
                                               "lockTicks": 10, "fuse": 15, "killTail": 92, "killHead": 60, "crossHalf": 1200, "speedRef": 300,
                                               "rangeFar": 70, "trackBonus": 15, "trackFull": 60, "killMin": 10, "killMax": 95, "leadTicks": 60 } } }] },
    // The jets' gun: one burst a second (a round of ammunition), out to 15 cells (E13, D-PUR1: 9 before; room
    // to shoot and still break off 6 cells out instead of flying through the target), 90 damage through the
    // air_gun warhead (a drone dies to one burst, a jet takes about four). The air superiority jet
    // carries 10 bursts, the multirole 8. Fired within a 10-degree cone of the nose (E6), or
    // strafing (E7). A burst's best hit chance by class (airGun.hitBase): one-way and FPV drones 85,
    // the scout drone 70, the Watcher 50, the Overseer 60, the multirole 30, the air superiority jet 25
    // (before its signature), halved by a 600 mrad/s crossing, 50% left at full range. Strafing (E7):
    // fire opens 18 cells out (slant), a burst every quarter second, each landing as a 1-cell splash
    // (splash 10) at a point that walks across the target (about 4 bursts a pass).
    { "id": "fighter_gun", "requires": ["jet"],
      "effects": [{ "weapon": { "damage": 90, "range": 150, "reload": 20, "warhead": "air_gun", "targets": ["air", "ground"], "splash": 10,
                                "ammo": 10, "ammoPerRocket": true, "noResupply": true,
                                "airGun": { "cone": 10, "hitBase": { "drone": 85, "fpv": 85, "scout": 70, "watcher": 50, "overseer": 60, "multirole": 30, "fighter": 25 },
                                            "crossHalf": 600, "rangeFar": 50, "strafeRange": 180, "strafeEvery": 5 } } }] },
    { "id": "multirole_gun", "requires": ["jet"],
      "effects": [{ "weapon": { "damage": 90, "range": 150, "reload": 20, "warhead": "air_gun", "targets": ["air", "ground"], "splash": 10,
                                "ammo": 8, "ammoPerRocket": true, "noResupply": true,
                                "airGun": { "cone": 10, "hitBase": { "drone": 85, "fpv": 85, "scout": 70, "watcher": 50, "overseer": 60, "multirole": 30, "fighter": 25 },
                                            "crossHalf": 600, "rangeFar": 50, "strafeRange": 180, "strafeEvery": 5 } } }] },
    // The air superiority jet's two small precision glide bombs (250 lb class): 350 damage through
    // the bomb warhead (700 to a building), a 3-cell splash from 100% at the centre to 25% at its
    // edge; released level from 70 m up to 50 cells out, guided (hit 95% on a target that stood still,
    // 75% on one that moved, a miss 3 to 5 cells off: the delivery block, E7); a small runway crater.
    { "id": "glide_bombs", "requires": ["jet"],
      "effects": [{ "weapon": { "runway": { "crater": "small" }, "damage": 350, "range": 500, "reload": 20, "warhead": "bomb",
                                "splash": 30, "splashCenter": 100, "splashEdge": 25, "projectileSpeed": 200, "targets": ["ground"],
                                "ammo": 2, "ammoPerRocket": true, "noResupply": true,
                                "delivery": { "profile": "level", "releaseHeight": 700,
                                              "guided": { "hitIdle": 95, "hitMoving": 75, "missNear": 30, "missFar": 50 } } } }] },
    // The multirole's loadouts (decision D18: two presets). Preset A: 4 x 500 lb general-purpose
    // bombs (Mk 82 type): 700 damage (1,400 to a building), two rings (100% within 2 cells, 30% out to
    // 5), dived on by default from a 16-cell initial point at 35 degrees, released 60 m up, 1.0 cell
    // of scatter in a dive (1.5 level, 3.0 tossed: the delivery block, E7), a small runway crater. A
    // free-fall bomb falls at the game's bomb gravity (gravity 700: 70 m/s^2, compressed like the jets'
    // speeds, so a dive released at 60 m lands about 19 cells on, a level drop about 26).
    { "id": "bombs_500lb", "requires": ["jet"],
      "effects": [{ "weapon": { "runway": { "crater": "small" }, "damage": 700, "range": 300, "reload": 10, "warhead": "bomb",
                                "splash": 50, "splashInner": 20, "splashCenter": 100, "splashOuterPercent": 30,
                                "projectileSpeed": 200, "targets": ["ground"], "ammo": 4, "ammoPerRocket": true, "noResupply": true,
                                "delivery": { "profile": "dive", "releaseHeight": 600, "diveAngle": 35, "tossAngle": 30, "ipDistance": 160,
                                              "scatterLevel": 15, "scatterDive": 10, "scatterToss": 30, "gravity": 700 } } }] },
    // Preset B: 2 x 2,000 lb general-purpose bombs (Mk 84 type): 1,300 damage (2,600 to a building),
    // two rings (100% within 3 cells, 30% out to 8), the same delivery, a large runway crater.
    { "id": "bombs_2000lb", "requires": ["jet"],
      "effects": [{ "weapon": { "runway": { "crater": "large" }, "damage": 1300, "range": 300, "reload": 20, "warhead": "bomb",
                                "splash": 80, "splashInner": 30, "splashCenter": 100, "splashOuterPercent": 30,
                                "projectileSpeed": 200, "targets": ["ground"], "ammo": 2, "ammoPerRocket": true, "noResupply": true,
                                "delivery": { "profile": "dive", "releaseHeight": 600, "diveAngle": 35, "tossAngle": 30, "ipDistance": 160,
                                              "scatterLevel": 15, "scatterDive": 10, "scatterToss": 30, "gravity": 700 } } }] },
    // The pilot's compact rifle (a PDW type; E8, the plan's section 3.2): 8 damage, 4 cells, 0.6 s.
    { "id": "compact_rifle", "requires": ["infantry"], "cost": 0,
      "effects": [{ "weapon": { "damage": 8, "range": 40, "reload": 12, "warhead": "bullet", "targets": ["ground", "air"] } }] },

    // The bulldozer's builder: the worker's (worker_build, rate 100) with 2.5 cells of reach instead
    // of 1.5, since a vehicle keeps a cell clear of a footprint and could not reach a site's corner.
    { "id": "dozer_build", "requires": ["worker"],
      "effects": [{ "builder": { "rate": 100, "range": 25 } }] }
  ]
}
