{
  // Launchers fire salvos of salvoSize rockets, one every salvoInterval
  // ticks, each landing up to scatter (tenths of a cell, per axis) from where
  // the target stood when the salvo began. ammo is in salvos; an empty
  // launcher goes quiet until supply rearms it. Their range outreaches their
  // own vision, so they need a friendly spotter. runway: what a blast landing on an airfield's
  // runway does to it (the game repo's docs/airfield-design.md, 1.1): missiles, drone charges and
  // heavy rockets of 250 or more dig a crater on impact (the ballistic missile a large one); light
  // rockets add wear that craters only under sustained fire; anything without it does nothing.
  "components": [
    { "id": "bike_gun", "requires": ["vehicle"],
      "effects": [{ "weapon": { "damage": 6, "range": 40, "reload": 8, "warhead": "bullet", "targets": ["ground", "air"] } }] },
    { "id": "heavy_mg", "requires": ["vehicle"],
      "effects": [{ "weapon": { "damage": 12, "range": 60, "reload": 5, "warhead": "bullet", "targets": ["ground", "air"] } }] },
    { "id": "light_rockets", "requires": ["launcher"],
      "effects": [{ "weapon": { "runway": { "wear": 2 }, "damage": 30, "range": 60, "reload": 100, "warhead": "rocket", "splash": 10, "scatter": 8,
                                "projectileSpeed": 120, "salvoSize": 4, "salvoInterval": 3, "ammo": 4 } }] },
    { "id": "medium_rockets", "requires": ["launcher"],
      "effects": [{ "weapon": { "runway": { "wear": 3 }, "damage": 35, "range": 120, "reload": 160, "warhead": "rocket", "splash": 12, "scatter": 12,
                                "projectileSpeed": 140, "salvoSize": 6, "salvoInterval": 3, "ammo": 4 } }] },
    // The rocket truck's 30-tube launcher: a ripple salvo of 30 rockets, one every
    // 0.5 s, scattered about 3.5 cells around the aim point; 15 to 60 cells away
    // only. Its own warhead (mrl_rocket: the rocket's table plus 68% against infantry and about
    // 11% against vehicles) makes a direct hit 113 x 133% = 150 HP: two kill a technical (180);
    // splash is 12% of that at the centre, falling to 4% at 3 cells: a full salvo on a
    // clustered group kills about half the infantry and badly damages the vehicles. Ammo is
    // counted in rockets and only a supply depot reloads it: one every 2 s,
    // starting 1 s after it last fired, never during a salvo.
    { "id": "heavy_rockets", "requires": ["launcher"],
      "effects": [{ "weapon": { "runway": { "wear": 4 }, "damage": 113, "range": 600, "minRange": 150, "reload": 20, "warhead": "mrl_rocket",
                                "splash": 30, "splashCenter": 12, "splashEdge": 4, "scatter": 35,
                                "projectileSpeed": 160, "salvoSize": 30, "salvoInterval": 10,
                                "ammo": 30, "ammoPerRocket": true,
                                "depotReload": { "everyTicks": 40, "afterFireTicks": 20, "cost": 10 }, "targets": ["ground"] } }] },
    // The heavy rocket truck's rockets: 360 damage (720 to buildings: 4 bring down a panel block,
    // 3 a brick block; a direct hit still destroys a technical), a 5-cell splash falling from 100% at
    // the centre to 10% at the edge, 4 cells of scatter, 14 cells/s on a high arc, 50 to 90 cells.
    // 12 rockets, one every 2 s; a depot reloads one every 5 s, 1 s after the last shot,
    // for 40 supply each (4% of a full depot; the rocket truck's rockets cost 10).
    { "id": "heavy_artillery_rockets", "requires": ["launcher"],
      "effects": [{ "weapon": { "runway": { "crater": "small" }, "damage": 360, "range": 900, "minRange": 500, "reload": 20, "warhead": "heavy_rocket",
                                "splash": 50, "splashCenter": 100, "splashEdge": 10, "scatter": 40,
                                "projectileSpeed": 140, "salvoSize": 12, "salvoInterval": 40,
                                "ammo": 12, "ammoPerRocket": true,
                                "depotReload": { "everyTicks": 100, "afterFireTicks": 20, "cost": 40 }, "targets": ["ground"] } }] },
    // The twin missile truck's 2 missiles, 6 s apart, from 45 to 100 cells on a high arc with
    // 3 cells of scatter: 550 damage (1210 to buildings: 2 bring down a panel block) and a
    // two-ring splash, full damage within 3 cells, a flat 30% (165) out to 9 cells. Reloaded
    // only at a depot and only stowed: one missile every 10 s, 1 s after the last shot, for
    // 150 supply (15%) each.
    // The rocket jeep's two short-range heavy rockets: 450 damage (900 to buildings: 2 bring down a
    // brick block, 3 a panel block), a 4-cell splash from 100% at the centre to 20% at the edge,
    // 3 cells of scatter, 16 cells/s, 20 to 50 cells; 2 rockets 3 s apart; reloaded only at a
    // depot and only stowed, one every 6 s, 1 s after the last shot, for 80 supply each.
    { "id": "jeep_rockets", "requires": ["launcher"],
      "effects": [{ "weapon": { "runway": { "crater": "small" }, "damage": 450, "range": 500, "minRange": 200, "reload": 20, "warhead": "heavy_rocket",
                                "splash": 40, "splashCenter": 100, "splashEdge": 20, "scatter": 30,
                                "projectileSpeed": 160, "salvoSize": 2, "salvoInterval": 60,
                                "ammo": 2, "ammoPerRocket": true,
                                "depotReload": { "everyTicks": 120, "afterFireTicks": 20, "cost": 80, "stowed": true },
                                "targets": ["ground"] } }] },
    // The air defence vehicle's radar-guided missiles, against one-way attack drones only (the
    // "drone" interception class), built on the AA soldier's igla (same lock, lead pursuit, fuse
    // and kill roll) but better in every term: 220 cells of slant range (12 minimum) against 140,
    // 45 cells/s (1.5x the soldier's, 3.75x the drone's cruise) for 300 cells of flight (6.7 s),
    // 60 degrees a second of turn, a 1 s lock, launched from the turret 3.3 m up. A 4 m proximity
    // fuse and a bigger warhead: the kill roll is 92% tail-on and 80% head-on (the soldier 78% / 42%;
    // radar guidance cares less about aspect than an IR seeker), halved only by a 1200 mrad/s
    // crossing (600), 80% left at full range (70%), up to +15% for a long track. 10 missiles in two
    // packs of 5, 1.5 s between launches; only a supply depot refills them, 4 s and 60 supply a missile.
    // It also engages the scout drone ("scout" class), its chances scaled so the best shot is 20%,
    // and the Sentinel's Watcher strike drone ("watcher": 40% at best; docs/watcher-design.md). The
    // Overseer surveillance drone ("overseer") takes a flat hit roll instead (hits): 65%, and a hit kills.
    { "id": "sam_missiles", "requires": ["vehicle"], "cost": 200,
      "effects": [{ "weapon": { "damage": 100, "range": 2200, "minRange": 120, "reload": 30, "warhead": "aa_missile",
                                "projectileSpeed": 450, "targets": ["air"], "ammo": 10, "ammoPerRocket": true,
                                "depotReload": { "everyTicks": 80, "afterFireTicks": 20, "cost": 60 },
                                "guided": { "maxFlight": 3000, "turnRate": 60 },
                                "intercept": { "classes": ["drone", "scout", "watcher", "overseer"], "killBest": { "scout": 20, "watcher": 40 },
                                               "hits": { "overseer": { "chance": 65, "damage": 100 } }, "lockTicks": 20, "fuse": 20, "killTail": 92, "killHead": 80,
                                               "crossHalf": 1200, "speedRef": 120, "rangeFar": 80, "trackBonus": 15, "trackFull": 100,
                                               "killMin": 10, "killMax": 95, "leadTicks": 80, "launchHeight": 33 } } }] },
    { "id": "twin_missiles", "requires": ["launcher"],
      "effects": [{ "weapon": { "runway": { "crater": "small" }, "damage": 550, "range": 1000, "minRange": 450, "reload": 20, "warhead": "heavy_missile",
                                "splash": 90, "splashInner": 30, "splashCenter": 100, "splashOuterPercent": 30, "scatter": 30,
                                "projectileSpeed": 140, "salvoSize": 2, "salvoInterval": 120,
                                "ammo": 2, "ammoPerRocket": true,
                                "depotReload": { "everyTicks": 200, "afterFireTicks": 20, "cost": 150, "stowed": true },
                                "targets": ["ground"] } }] },
    // One-way attack drones, fired at a point on the ground fixed at launch: off a rail with a
    // booster, climbing at up to 12 m/s and rounding off over 2 s (roundOff) into level cruise 30 m
    // over the map's highest ground, cruising there at 12 cells/s, then a 2 s pitch-over (pitchOver)
    // into a 55-degree dive (dive 1428: metres down per 1000 forward) that ends on the point; up to
    // 600 cells. A hill in the climb, or the
    // first wall, vehicle or soldier in the dive, sets it off. 260 damage (infantry die, vehicles
    // up to 260 HP die, 300-HP trucks survive hurt), a 4-cell blast from 100% to 40% at its edge;
    // a building loses 20% of its max HP a drone (the warhead's rule). Marked "drone" for future
    // air defence.
    // The drone launcher truck: 2 drones on rails, one per designated point, 3 s apart; reloaded
    // only at a depot and only stowed, 30 s and 150 supply (15%) a drone.
    { "id": "drone_rails", "requires": ["launcher"],
      "effects": [{ "weapon": { "runway": { "crater": "small" }, "damage": 260, "range": 6000, "minRange": 150, "reload": 60, "warhead": "drone_charge",
                                "splash": 40, "splashCenter": 100, "splashEdge": 40,
                                "projectileSpeed": 120, "salvoSize": 1, "salvoInterval": 1,
                                "drone": { "cruiseAboveMax": 300, "climbRate": 120, "boosterTicks": 20, "dive": 1428, "launchHeight": 25,
                                           "roundOff": 40, "pitchOver": 40 },
                                "interceptible": "drone", "ammo": 2, "ammoPerRocket": true,
                                "depotReload": { "everyTicks": 600, "afterFireTicks": 20, "cost": 150, "stowed": true },
                                "targets": ["ground"] } }] },
    // The engineer's drone station: one drone, fired remotely; nothing refills it.
    { "id": "drone_station_rail", "requires": ["station"],
      "effects": [{ "weapon": { "runway": { "crater": "small" }, "damage": 260, "range": 6000, "minRange": 150, "reload": 60, "warhead": "drone_charge",
                                "splash": 40, "splashCenter": 100, "splashEdge": 40,
                                "projectileSpeed": 120, "salvoSize": 1, "salvoInterval": 1,
                                "drone": { "cruiseAboveMax": 300, "climbRate": 120, "boosterTicks": 20, "dive": 1428, "launchHeight": 12,
                                           "roundOff": 40, "pitchOver": 40 },
                                "interceptible": "drone", "ammo": 1, "ammoPerRocket": true, "noResupply": true,
                                "targets": ["ground"] } }] },
    // The tactical missile truck's ballistic missile: about 1.3x the twin missile. 730 damage
    // (1606 to buildings: a brick block falls in 1 hit, a panel block in 2), a two-ring splash 10%
    // bigger (full within 3.3 cells, a flat 30% out to 9.9), 60 to 160 cells, 1.8x the twin
    // missile's speed (25.2 cells/s) on a steep arc rising 45% of the distance. One missile;
    // reloaded only at a depot and only stowed: 60 s, 1 s after the shot, for 250 supply (25%).
    // Marked "ballistic" for future interceptors: fast and from a high apex, hard to stop. Its own
    // warhead (ballistic) is the heavy missile's table plus 170% against armour: the one strike that
    // destroys an infantry carrier.
    { "id": "ballistic_missile", "requires": ["launcher"],
      "effects": [{ "weapon": { "runway": { "crater": "large" }, "damage": 730, "range": 1600, "minRange": 600, "reload": 20, "warhead": "ballistic",
                                "splash": 99, "splashInner": 33, "splashCenter": 100, "splashOuterPercent": 30, "scatter": 30,
                                "projectileSpeed": 252, "salvoSize": 1, "salvoInterval": 1, "arc": 45, "interceptible": "ballistic",
                                "ammo": 1, "ammoPerRocket": true,
                                "depotReload": { "everyTicks": 1200, "afterFireTicks": 20, "cost": 250, "stowed": true },
                                "targets": ["ground"] } }] }
  ]
}
