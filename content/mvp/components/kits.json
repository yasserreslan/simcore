{
  // Kits and payloads. radius, range and contact in tenths of a cell;
  // cooldown and everyTicks in ticks. Charges start full and are restocked
  // by supply depots.
  "components": [
    { "id": "trap_kit", "requires": ["infantry"], "cost": 20,
      "effects": [{ "placer": { "archetype": "booby_trap", "charges": 3, "cooldown": 40, "range": 15, "maxActive": 3 } }] },
    { "id": "booby_trap", "requires": ["infantry"], "cost": 15,
      "effects": [{ "placer": { "archetype": "booby_trap", "charges": 2, "cooldown": 40, "range": 15, "maxActive": 3 } }] },
    { "id": "drone_kit", "requires": ["infantry"], "cost": 40,
      "effects": [{ "launch": { "archetype": "fpv_drone", "charges": 2, "cooldown": 60, "range": 150 } }] },
    // The engineer's drone station kit: one station, set up in 2 s at a cell up to 1.5 cells away;
    // only a supply depot refills it (10 s, 150 supply).
    { "id": "drone_station_kit", "requires": ["infantry"],
      "effects": [{ "placer": { "archetype": "drone_station", "charges": 1, "cooldown": 0, "range": 15, "maxActive": 3,
                                "placeTicks": 40, "depotReload": { "everyTicks": 200, "afterFireTicks": 0, "cost": 150 } } }] },
    { "id": "repair_kit", "requires": ["infantry"], "cost": 20,
      "effects": [{ "repair": { "rate": 6, "everyTicks": 20, "radius": 25, "affects": ["vehicle"] } }] },

    // A trap fires once on an enemy ground unit with one of the affects tags.
    { "id": "trap_charge", "requires": ["trap"],
      "effects": [{ "trigger": { "radius": 8, "damage": 90, "warhead": "explosive", "splash": 15,
                                 "affects": ["infantry", "vehicle"] } }] },
    { "id": "fpv_charge", "requires": ["drone"],
      "effects": [{ "strike": { "contact": 5, "damage": 70, "warhead": "explosive", "splash": 12 } }] },

    // Supply (depots only: trucks no longer rearm): rearm amount per unit per period;
    // stock 0 is unlimited (a limited stock never refills by itself); restock refills
    // limited suppliers out of the giver's own stock; reloadBonus is a percent. A depot
    // holds 1000 supply and starts full: each salvo or charge it gives costs 1, and
    // launchers it reloads pay their weapon's depotReload.cost per rocket. Cargo trucks
    // refill it.
    { "id": "depot_supply", "requires": ["structure"],
      "effects": [{ "supply": { "radius": 80, "everyTicks": 40, "amount": 1, "stock": 1000, "restock": 0, "reloadBonus": 20 } }] },

    // Cargo: supply a cargo truck carries to a depot, all or nothing (it is full or
    // empty), and the ticks it stands in the depot's radius to unload (3 s).
    { "id": "cargo_load", "requires": ["vehicle"],
      "effects": [{ "cargo": { "amount": 400, "unloadTicks": 60 } }] }
  ]
}
