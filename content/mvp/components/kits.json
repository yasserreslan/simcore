{
  // Kits and payloads. radius, range and contact in tenths of a cell;
  // cooldown and everyTicks in ticks. Charges start full and are restocked
  // by supply depots.
  "components": [
    { "id": "trap_kit", "requires": ["infantry"], "cost": 20,
      "effects": [{ "placer": { "archetype": "booby_trap", "charges": 3, "cooldown": 40, "range": 15, "maxActive": 3 } }] },
    { "id": "booby_trap", "requires": ["infantry"], "cost": 15,
      "effects": [{ "placer": { "archetype": "booby_trap", "charges": 2, "cooldown": 40, "range": 15, "maxActive": 3 } }] },
    { "id": "drone_kit", "requires": ["infantry"], "cost": 40,
      "effects": [{ "launch": { "archetype": "fpv_drone", "charges": 2, "cooldown": 60, "range": 150 } }] },
    // The engineer's drone station kit: one station, set up in 2 s at a cell up to 1.5 cells away;
    // only a supply depot refills it (10 s, 150 supply).
    { "id": "drone_station_kit", "requires": ["infantry"],
      "effects": [{ "placer": { "archetype": "drone_station", "charges": 1, "cooldown": 0, "range": 15, "maxActive": 3,
                                "placeTicks": 40, "depotReload": { "everyTicks": 200, "afterFireTicks": 0, "cost": 150 } } }] },
    // The engineer's Kaman station kit (the Kaman option of his drone station; docs/design.md, "Kaman drone"): one
    // station holding one Kaman drone, set up in 3 s at a cell up to 1.5 cells away (a second takes the first down);
    // only a supply depot refills it (30 s, 400 supply: the Kaman truck's reload cost).
    { "id": "kaman_station_kit", "requires": ["infantry"],
      "effects": [{ "placer": { "archetype": "kaman_station", "charges": 1, "cooldown": 0, "range": 15, "maxActive": 1,
                                "placeTicks": 60, "depotReload": { "everyTicks": 600, "afterFireTicks": 0, "cost": 400 } } }] },
    // The scout drone (docs: the game repo's docs/air-defense-design.md, section 10): one drone per
    // launcher, aloft one at a time (maxActive); launched at a point anywhere (range), it flies there
    // and orbits. A drone that comes home is the launcher's again (after the drone's turnaround).
    // The truck's catapult: a drone lost is replaced only at a depot, 30 s and 300 supply, never
    // while its own is aloft.
    { "id": "scout_catapult", "requires": ["vehicle"],
      "effects": [{ "launch": { "archetype": "scout_drone", "charges": 1, "cooldown": 40, "range": 20000, "maxActive": 1,
                                "depotReload": { "everyTicks": 600, "afterFireTicks": 0, "cost": 300 } } }] },
    // The reusable scout launch (no tag needed: any archetype may carry it, e.g. a structure a sniper
    // garrisons): one drone, single use; nothing refills it but its own drone coming home. On the
    // sniper's station, spent (its drone lost), the station goes 20 s later (expireWhenEmpty).
    { "id": "scout_station_launch", "requires": [],
      "effects": [{ "launch": { "archetype": "scout_drone", "charges": 1, "cooldown": 0, "range": 20000, "maxActive": 1,
                                "noResupply": true } }] },
    // The sniper's scout station kit: one station, set up in 2 s at a cell up to 1.5 cells away
    // (placing a second takes the first down); only a supply depot refills it (20 s, 300 supply).
    { "id": "scout_station_kit", "requires": ["infantry"],
      "effects": [{ "placer": { "archetype": "scout_station", "charges": 1, "cooldown": 0, "range": 15, "maxActive": 1,
                                "placeTicks": 40, "depotReload": { "everyTicks": 400, "afterFireTicks": 0, "cost": 300 } } }] },
    { "id": "repair_kit", "requires": ["infantry"], "cost": 20,
      "effects": [{ "repair": { "rate": 6, "everyTicks": 20, "radius": 25, "affects": ["vehicle"] } }] },

    // The assault soldier's mines (docs/design.md, "Traps"): laid in 1.5 s at a cell up to 1.5 cells
    // away; at most 8 anti-personnel and 4 anti-tank mines of one soldier on the map (laying another
    // lifts his oldest); a depot refills the kit (a charge a period, as for the trap kit).
    { "id": "ap_mine_kit", "requires": ["infantry"], "cost": 20,
      "effects": [{ "placer": { "archetype": "ap_mine", "charges": 4, "cooldown": 20, "range": 15, "maxActive": 8, "placeTicks": 30 } }] },
    { "id": "at_mine_kit", "requires": ["infantry"], "cost": 30,
      "effects": [{ "placer": { "archetype": "at_mine", "charges": 2, "cooldown": 20, "range": 15, "maxActive": 4, "placeTicks": 30 } }] },

    // A trap fires once on an enemy ground unit with one of the affects tags (the trigger system:
    // also on its owner's order, or set off by another trap's blast; docs/design.md, "Traps").
    // The anti-personnel mine: steps within 0.6 cell (1.2 m) set it off; the blast reaches 3 cells
    // (6 m): 120 at the centre falling to 30 at the edge, so soldiers within about 2 cells (4 m) die
    // and those out to 3 are wounded; vehicles take a scratch (ap_blast). Any enemy on the ground,
    // soldier or vehicle, sets it off.
    { "id": "ap_mine_charge", "requires": ["trap"],
      "effects": [{ "trigger": { "radius": 6, "damage": 120, "warhead": "ap_blast", "splash": 30, "edge": 25,
                                 "affects": ["infantry", "vehicle"] } }] },
    // The anti-tank mine: only a vehicle within 1.2 cells (2.4 m: under its hull) sets it off, and that
    // vehicle is destroyed whatever its armour (kills); the blast reaches 1.5 cells (3 m), 80 falling
    // to 40, and never destroys a second vehicle. Soldiers walk over it.
    { "id": "at_mine_charge", "requires": ["trap"],
      "effects": [{ "trigger": { "radius": 12, "damage": 80, "warhead": "at_blast", "splash": 15,
                                 "affects": ["vehicle"], "kills": ["vehicle"] } }] },
    // A trap fires once on an enemy ground unit with one of the affects tags.
    { "id": "trap_charge", "requires": ["trap"],
      "effects": [{ "trigger": { "radius": 8, "damage": 90, "warhead": "explosive", "splash": 15,
                                 "affects": ["infantry", "vehicle"] } }] },
    { "id": "fpv_charge", "requires": ["drone"],
      "effects": [{ "strike": { "runway": { "crater": "small" }, "contact": 5, "damage": 70, "warhead": "explosive", "splash": 12 } }] },

    // Supply (depots only: trucks no longer rearm): rearm amount per unit per period;
    // stock 0 is unlimited (a limited stock never refills by itself); restock refills
    // limited suppliers out of the giver's own stock; reloadBonus is a percent. A depot
    // holds 1000 supply and starts full (one a worker builds starts empty: constructedStock):
    // each salvo or charge it gives costs 1, and launchers it reloads pay their weapon's
    // depotReload.cost per rocket. Cargo trucks refill it.
    { "id": "depot_supply", "requires": ["structure"],
      "effects": [{ "supply": { "radius": 80, "everyTicks": 40, "amount": 1, "stock": 1000, "restock": 0, "reloadBonus": 20,
                                 "constructedStock": 0 } }] },

    // Building: a worker builds structures at rate percent of their buildTime, from within
    // range (tenths of a cell) of the site's footprint.
    { "id": "worker_build", "requires": ["worker"],
      "effects": [{ "builder": { "rate": 100, "range": 15 } }] },

    // Cargo: supply a cargo truck carries to a depot, all or nothing (it is full or
    // empty), and the ticks it stands in the depot's radius to unload (3 s).
    { "id": "cargo_load", "requires": ["vehicle"],
      "effects": [{ "cargo": { "amount": 400, "unloadTicks": 60 } }] }
  ]
}
