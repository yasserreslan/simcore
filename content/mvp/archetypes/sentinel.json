      // Loadout (fixed): 6 radar missiles, 2 IR missiles, 10 gun bursts, 2 glide bombs; 4 flare and 4
      // chaff salvos a sortie. Firing is E6 / E7.
      "id": "fighter_jet", "name": "Air superiority fighter", "glyph": "f", "tags": ["jet", "aircraft"],
      "locomotor": "flying", "armor": "aircraft", "hp": 320, "speed": 210, "turnRate": 2,
      "vision": 450, "airVision": 1600, "lifetime": 4800, "buildTime": 1000, "cost": 2400,
      "components": ["aam_radar", "aam_ir", "fighter_gun", "glide_bombs"],
      // E13 (D-ALT1): 20% over the multirole: 168 m on maps up to 512 cells, 336 m at 1,024 (at most 384 m); runs in at 80 m.
      "flight": { "kind": "fixedWing", "height": 1680, "heightByMap": { "from": 512, "to": 1024, "height": 3360, "max": 3840 },
                  "enduranceByMap": { "from": 512, "to": 1024, "percent": 200 },
                  "speedByMap": { "from": 512, "to": 1024, "percent": 135, "dashPercent": 120 }, "climbRate": 300, "launchHeight": 10, "orbitRadius": 220,
                  "interceptible": "fighter", "reserve": 300, "recoverRange": 40, "turnaround": 600, "flyZoneMargin": 550,
                  "fixedWing": { "dash": 300, "attack": 240, "minSpeed": 90, "cornerSpeed": 160, "cornerRadius": 90,
                                 "sustainedRadius": 160, "accel": 45, "gravity": 20, "diveRate": 400, "floor": 100,
                                 "ingressHeight": 800, "lookAhead": 100, "separation": 30,
                                 "burn": { "idle": 60, "cruise": 100, "military": 140, "afterburner": 300 } } },
      "mission": { "huntLeash": 300, "guard": ["aircraft", "drones"] },
      "signature": { "detect": 50, "lock": 200, "kill": 60 },
      "countermeasures": [
        { "kind": "flare", "salvos": 4, "vs": "ir", "pk": 55, "window": 40, "perMissile": 1, "rearmTicks": 40, "breakPk": 30 },
        { "kind": "chaff", "salvos": 4, "vs": "radar", "pk": 60, "window": 40, "perMissile": 1, "rearmTicks": 40, "breakPk": 35 }
      ],
      "evade": { "breakG": 100, "warn": 60, "maxTicks": 50 }, // the same break as the multirole (E6)
      // Attack runs, elements and pursuit (E13) as the multirole's, scaled to its speeds and turns: align 72
      // cells (3 s at 24 cells/s), break 48, extend 96; slots 23 cells back and 8 aside (its 15.5-cell turn at cruise).
      "attackRun": { "align": 720, "breakTurn": 60, "break": 480, "extend": 960, "releaseWindow": 20, "offset": 10 },
      "element": { "slots": [ { "back": 230, "aside": 80 }, { "back": 230, "aside": -80 }, { "back": 460, "aside": 0 } ], "stagger": 60 },
      "pursuit": { "separation": 60, "breakOff": 40, "reattack": 300, "climb": 100, "maxTicks": 120 },
      "loss": { // the multirole's crash path and ejection (E10)
        "crash": { "warhead": "crash", "damage": 150, "splash": 30, "gravity": 400, "drag": 10, "breakUp": 40, "breakUpDrag": 50,
                   "runway": { "crater": "small" } },
        "eject": { "unit": "pilot", "seatRise": 400, "riseTicks": 20, "chuteTicks": 44, "chuteRate": 60, "drift": 10, "driftTicks": 60 }
      },
      // Class M: 70 cells to land, 50 to take off; the multirole's overhead break (E9) and takeoff rule, at
      // 9 cells/s on the approach (its break and base turns 11.25 cells), touchdown 8; 60 cells of corridor;
      // service at 1x: a full tank in 25 s, a round in 3.5 s (20 rounds: a full Rearm at a shelter about
      // 35 s), 12 HP/s.
      "aircraft": { "sizeClass": "M", "span": 61, "length": 85, "landing": "runway", "groundArmor": "parked_aircraft",
                    "minLandRun": 700, "minTakeoffRun": 500, "corridorNeed": 600,
                    "approach": { "pattern": "overhead", "initialDistance": 400, "patternHeight": 400, "breakSpeed": 140,
                                  "fixDistance": 120, "fixHeight": 120, "touchdown": 100, "flare": 50, "aerobrakeSpeed": 60,
                                  "rolloutDecel": 10, "brake": 20 },
                    "speeds": { "approach": 90, "touchdown": 80, "taxi": 35, "turn": 15, "pushback": 5, "takeoff": 90, "takeoffAccel": 20,
                                "militaryAccel": 12 },
                    "service": { "refuelTicks": 500, "rearmTicksPerRound": 70, "repairHpPerSecond": 12 },
                    "groundVision": 60, "groundEye": 25, "holdReserve": 600, "sortie": true }
    },
    {
      // The ground attack jet (an A-10 type; H2, the game repo's docs/heavy-air-plan.md, section 1.1; art:
      // art/export/attack_jet.glb, 17.5 m span, 16.3 m long). Class L: it needs the main air base's runway and
