      "vision": 60, "airVision": 8000, "cueLock": 70, "sweepTicks": 80, "counterStealth": 50,
      "radarHorizon": { "beyond": 2000, "below": 500 },
      "emitter": { "range": 8000, "radius": 20, "linger": 200, "excludeTags": ["infantry"] },
      "buildTime": 1200, "cost": 3000,
      "crew": { "tags": ["soldier"], "enterRange": 15, "survival": 50, "exitDamage": 40 }
