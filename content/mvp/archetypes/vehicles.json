    {
      // The air defence vehicle: a 6x6 amphibious boat-hull vehicle with a search radar and two
      // packs of 5 missile canisters, against one-way attack drones only (the AA soldier's job, done
      // further out and better: see the sam_missiles component and docs/air-defense-design.md in the
      // game repo). Its search radar sees air targets out to 260 cells (airVision, slant), against
      // the soldier's 150. Its launcher is fixed on the hull (no turret): the hull turns to its target at
      // 2 facings a tick, the old turret's rate (docs/design.md, "Launchers aim with the hull"); like the
      // soldier it engages in Guard, idle and standing (no deploy). Light armour, 280 HP: small arms
      // barely scratch it (40%), an RPG takes 84, a Kornet 126, a rocket-truck rocket 150, a drone
      // that gets through 260 (it survives one). Speed 30: a 6x6 wheeled vehicle between the drone
      // truck (25) and the technical (35). Its tag air_radar: an air radar the stealth multirole's radar spotting reveals.
      "id": "sam_vehicle", "crusher": 2, "name": "Air defence vehicle", "glyph": "V", "tags": ["vehicle", "air_radar"], "tunnelSize": 2, "tunnelSlots": 5,
      "locomotor": "wheeled", "armor": "light_vehicle", "hp": 280, "speed": 30, "radius": 9, "turnRate": 2,
      "vision": 60, "airVision": 2600, "buildTime": 500, "cost": 1000, "components": ["sam_missiles"],
      "crew": { "tags": ["soldier"], "enterRange": 15, "survival": 50, "exitDamage": 40 }
    },
    {
