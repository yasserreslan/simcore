      "vision": 50, "buildTime": 800, "cost": 2000, "components": ["ballistic_missile"],
      "crew": { "tags": ["soldier"], "enterRange": 15, "survival": 50, "exitDamage": 40 }
    },
    {
      // The infantry carrier: a long-nose 6x6 troop truck with an armoured cab and bed under a canvas
      // tarp. A driver plus 15 infantry in the back, who can't fire out (no ports). It must live
      // through any single strike in the game but the tactical ballistic missile and a full heavy
      // rocket salvo: its own armor class (armored_vehicle in warheads.json) and 1200 HP put every
      // other weapon's whole first salvo below 1200 even if every round hits (the twin missiles
      // 2 x 550 = 1100, the rocket jeep 2 x 540 = 1080, the rocket truck's 30 x 39 = 1170), while the
      // ballistic missile takes 1241. Speed 28: between the cargo truck (22) and the technical (35),
      // 80% of the technical; faster than every launcher, slower than the raiders.
      "id": "infantry_carrier", "crusher": 2, "name": "Infantry carrier", "glyph": "N", "tags": ["vehicle", "heavy"], "tunnelSize": 2, "tunnelSlots": 5,
      "locomotor": "wheeled", "armor": "armored_vehicle", "hp": 1200, "speed": 28, "radius": 11, "turnRate": 2,
      "vision": 60, "buildTime": 400, "cost": 700,
      "crew": { "tags": ["soldier"], "enterRange": 20, "survival": 50, "exitDamage": 40,
                "passengers": 15, "passengerTags": ["infantry"] }
    },
    {
