      "vision": 50, "buildTime": 1800, "cost": 4000, "components": ["hypersonic_missiles"],
      "exclusive": "hypersonic", // one a player at a time (exclusive_groups.json)
      "crew": { "tags": ["soldier"], "enterRange": 15, "survival": 50, "exitDamage": 40 }
