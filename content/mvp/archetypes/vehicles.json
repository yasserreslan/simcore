      // The slowest launcher: 70% of the heavy rocket truck's speed, 2 s to reach it.
      "id": "ballistic_truck", "name": "Tactical missile truck", "glyph": "Z", "tags": ["vehicle", "launcher"],
      "locomotor": "wheeled", "armor": "medium_vehicle", "hp": 300, "speed": 11, "radius": 12, "turnRate": 1, "turret": true,
