      "id": "cruise_truck", "crusher": 2, "name": "Cruise missile truck", "glyph": "j", "tags": ["vehicle", "launcher", "heavy"], "tunnelSize": 3, "tunnelSlots": 8,
      "locomotor": "wheeled", "armor": "medium_vehicle", "hp": 420, "speed": 16, "radius": 13, "turnRate": 1, "hullAims": true, "hullArc": 180,
      "deployTicks": 160, "stowTicks": 120, "deploySlope": 15, "accelTicks": 40,
      "vision": 50, "buildTime": 1600, "cost": 3500, "components": ["cruise_missile"],
      "crew": { "tags": ["soldier"], "enterRange": 15, "survival": 50, "exitDamage": 40 }
