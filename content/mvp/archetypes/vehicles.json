      "id": "heavy_rocket_truck", "name": "Heavy rocket truck", "glyph": "Q", "tags": ["vehicle", "launcher"],
      "locomotor": "wheeled", "armor": "medium_vehicle", "hp": 300, "speed": 16, "radius": 12, "turnRate": 1, "turret": true,
      "deployTicks": 80, "stowTicks": 60,
      "vision": 50, "buildTime": 600, "cost": 1400, "components": ["heavy_artillery_rockets"],
      "crew": { "tags": ["soldier"], "enterRange": 15, "survival": 50, "exitDamage": 40 }
