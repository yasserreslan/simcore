      "id": "rocket_jeep", "name": "Rocket jeep", "glyph": "J", "tags": ["vehicle", "launcher"],
      "locomotor": "wheeled", "armor": "medium_vehicle", "hp": 170, "speed": 35, "radius": 8, "turnRate": 2, "turret": true,
