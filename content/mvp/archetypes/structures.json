{
  // Scenarios place one supply depot per side; workers build more (construction). footprint is
  // in cells; buildTime is in ticks with one worker. construction: a fresh site has startHp
  // percent of its HP (rising with progress); stages 1-4 begin at those progress percents; a
  // cancelled site refunds refund percent (once there is an economy); the 1st, 2nd and 3rd
  // worker add helpers percent of their rate; on terrain the site's ground is flattened to a
  // pad, easing back over padBlend cells.
  "archetypes": [
    {
      "id": "supply_depot", "name": "Supply depot", "glyph": "D", "tags": ["structure"],
      "locomotor": "none", "armor": "building", "height": 40, "hp": 1000, "vision": 60, "cost": 400,
      "footprint": { "w": 6, "h": 6 }, "buildTime": 600,
      "construction": { "startHp": 10, "stages": [15, 40, 70, 95], "refund": 75, "helpers": [100, 50, 0], "padBlend": 3 },
      "components": ["depot_supply"]
    },
    // The vehicle garage (art/export/vehicle_garage.glb, 40 x 22 m): a factory (production) that
    // makes the faction's vehicles, two at once; built by workers (40 s). A finished vehicle takes
    // a random free door of the four (never the one the last vehicle took), appears on its bay
    // floor inside (bayPoints: the art's bay_00..03, 7.5 m inside the door), and drives out
    // crewed (a Rifleman at the wheel) through the door's exit (exits: exit_00..03, 3 m out) to
    // the rally point (the art's rally, 10 m out). Doors take 1.5 s. Below 35% HP (damage stage 3:
    // the doors are wreckage) it stops.
    {
      "id": "vehicle_garage", "name": "Vehicle garage", "glyph": "G", "tags": ["structure"],
      "locomotor": "none", "armor": "building", "height": 100, "hp": 2500, "vision": 50, "cost": 1000,
      "footprint": { "w": 20, "h": 11 }, "buildTime": 800,
      "construction": { "startHp": 10, "stages": [15, 40, 70, 95], "refund": 75, "helpers": [100, 50, 0], "padBlend": 3 },
      // excludeTags: tanks come only from the military garage (its 16 m bays; this yard's doors are 8 m apart).
      "production": { "tags": ["vehicle"], "excludeTags": ["tank"], "bays": 2, "queueMax": 10, "doorTicks": 30, "pushAfter": 200, "crew": "Rifleman",
                      "exits": [[60, 125], [100, 125], [20, 125], [140, 125]],
                      "bayPoints": [[60, 72], [100, 72], [20, 72], [140, 72]], "rally": [80, 160], "minHpPercent": 35 }
    },
    // The observation post (art/export/observation_post.glb, 10 x 8 m): a low camouflaged bunker on
    // a hill, built by workers (25 s), with a viewing slit, an optics head and a guyed mast. It is
    // its builder's for good (garrison.owned: only its side enters, never neutral when empty) and
    // holds 3 soldiers who fire out through the slit (+1 cell of range, +2 of vision). Medium-heavy:
    // 1500 HP of building armour (between the brick block's 1600 and the depot's 1000); explosive hits
    // reach its occupants at 15% (the blocks: 25%). When it is destroyed every occupant gets out
    // (collapseSurvival 100) with at most 40% of max HP: min(current HP, 40% of max), i.e. 60% damage.
    // It sees 16 cells (32 m: more than the sniper's 14, about twice a rifleman's 7), plus 5% per metre
    // it stands above the mean ground within 32 cells (64 m), up to +60%. On the hills review map the
    // ridge crest and the knoll above the settlement stand 5-6 m above that mean: about +30% (21 cells);
    // a 12 m hill or higher gets the +60% cap (25.6 cells, 51 m), still well inside the rocket truck's 60,
    // so launchers keep needing it as a spotter. With a sniper inside it is a launch point (launcherTags) for the scout
    // drone: it carries scout_station_launch (one drone aloft at a time; single use like the sniper's
    // station: only its own drone coming home makes it ready again), usable only while a sniper is in. Its optics reveal hidden traps within 10 cells (detect), in its side's sight. Tagged stealth: the coming minimap shows it to the enemy only while spotted.
    {
      "id": "observation_post", "name": "Observation post", "glyph": "O", "tags": ["structure", "garrisonable", "stealth"],
      "locomotor": "none", "armor": "building", "height": 30, "hp": 1500, "vision": 160, "detect": 100, "cost": 500,
      "footprint": { "w": 5, "h": 4 }, "buildTime": 500, "components": ["scout_station_launch"],
      "highGround": { "percentPerMetre": 5, "maxPercent": 60, "radius": 32 },
      "construction": { "startHp": 10, "stages": [15, 40, 70, 95], "refund": 75, "helpers": [100, 50, 0], "padBlend": 2 },
      "garrison": {
        "capacity": 3, "tags": ["infantry"], "enterRange": 12, "rangeBonus": 10, "visionBonus": 20,
        "deployTags": ["mortar"], // the only building a mortar sets up and fires from (owner, 2026-10-18)
        "occupantDamage": 15, "occupantWarheads": ["rocket", "explosive", "heavy_rocket", "heavy_missile", "ballistic", "atgm"],
        "stages": [80, 60, 35], "stageCapacity": [100, 100, 100, 67], "ejectDamage": 20,
        "collapseSurvival": 100, "collapseHp": 40,
        "doors": [[2, -1]], "owned": true, "launcherTags": ["sniper"]
      }
    },
    // The howitzer (an M777 type, docs/design.md "Howitzer"; owner's spec 2026-10-24): a fixed emplacement, 10 x 10 cells
    // (20 x 20 m: the gun, its four trail legs, sandbags, a camo net and a shell pallet), built by a worker (40 s, 1,500), 1,200
    // HP of building armour; it sees only 4 cells past its footprint (it relies on spotters). It fires only with a crewman in
    // its one seat (crew: any of its side's soldiers, entered from 1.5 cells of the footprint; he takes 15% of an explosive
    // hit on the gun and bails out of its destruction by the vehicle crew rule: 50% to live, 40% of his HP lost). The gun
    // traverses all round, slowly: one facing (11.25 degrees) every 8 ticks, half a turn in 6.4 s. Its 155 mm gun is
    // howitzer_155 (components/vehicle_weapons.json): 15 shells, reloaded only by cargo trucks.
    {
      "id": "howitzer", "name": "Howitzer", "glyph": "Z", "tags": ["structure", "artillery"],
      "locomotor": "none", "armor": "building", "height": 30, "hp": 1200, "vision": 40, "cost": 1500,
      "footprint": { "w": 10, "h": 10 }, "buildTime": 800, "turret": true, "traverseTicks": 8,
      "construction": { "startHp": 10, "stages": [15, 40, 70, 95], "refund": 75, "helpers": [100, 50, 0], "padBlend": 3 },
      "crew": { "tags": ["soldier"], "enterRange": 15, "survival": 50, "exitDamage": 40,
                "occupantDamage": 15, "occupantWarheads": ["rocket", "mrl_rocket", "explosive", "heavy_rocket", "heavy_missile", "ballistic", "atgm",
                                                           "drone_charge", "kaman_charge", "mortar_bomb", "air_strike", "bomb", "he_mpat",
                                                           "autocannon", "heli_cannon_he", "crash"] },
      "components": ["howitzer_155"]
    },
    // Tunnel entrances (docs/design.md, "Tunnels"; owner's spec 2026-10-18). Workers build them
    // (no cost yet); a finished one links to its side's entrances within 60 cells (link), units
    // travel underground at 3 cells a second (speed) and a connected network shares the sum of its
    // capacities (slots: infantry 1, light vehicles 3, medium 5, heavy 8, a carrier 5 + 1 a rider).
    // size: the largest unit size in and out (1 infantry, 2 light and medium vehicles, 3 heavy);
    // vehicles travel only through size-2+ entrances (a medium one is a junction heavies pass but
    // can't leave by). throughput: ticks per unit through the door; destroyed, an entrance is
    // rubble (rubbleHp) that still counts and connects but lets nobody through; destroying the
    // rubble removes it, units at it move to a linked entrance or die, and the ground returns over
    // restoreTicks. Medium entrances and hatches are hidden until a detector (sniper, scout drone,
    // observation post) finds them; they see 6/4/3 cells round them (a guard at the door, no more);
    // any unit passing a door shows it for exposeTicks to enemies
    // that see it. Ground: the footprint and apron (cells in front) flat at their mean height, the
    // headwall rows (depth) under a mound (tenths of a metre; hillMound when the land behind
    // rises by hillGrade percent or more: built into the hillside), wing walls on the outer
    // columns, easing back over blend cells. Footprints are square (any quarter turn); 1 cell = 2 m.
    // Openings (the art): large 9 x 7.5 m (a 10 m ramp), medium 4.8 x 5.8 m, sized for the real models (the
    // air defence vehicle is 3.4 m wide and 5.5 m tall, the ballistic truck 3.25 x 4.3 m).
    {
      "id": "tunnel_large", "name": "Large tunnel", "glyph": "U", "tags": ["structure", "tunnel"],
      "locomotor": "none", "armor": "building", "height": 100, "hp": 1500, "vision": 60, "cost": 0,
      "footprint": { "w": 7, "h": 7 }, "buildTime": 800,
      "construction": { "startHp": 10, "stages": [15, 40, 70, 95], "refund": 75, "helpers": [100, 50, 0], "padBlend": 0 },
      "tunnel": { "size": 3, "capacity": 40, "throughput": 20, "rubbleHp": 750, "link": 600, "spacing": 120, "speed": 30,
                  "exposeTicks": 200, "flatGrade": 10, "hillGrade": 15, "depth": 2, "walls": true, "mound": 100, "hillMound": 110,
                  "apron": 3, "blend": 6, "emergeDamage": 40, "restoreTicks": 600 }
    },
    {
      "id": "tunnel_medium", "name": "Medium tunnel", "glyph": "u", "tags": ["structure", "tunnel", "stealth"],
      "locomotor": "none", "armor": "building", "height": 70, "hp": 1000, "vision": 40, "cost": 0, "hidden": true,
      "footprint": { "w": 5, "h": 5 }, "buildTime": 500,
      "construction": { "startHp": 10, "stages": [15, 40, 70, 95], "refund": 75, "helpers": [100, 50, 0], "padBlend": 0 },
      "tunnel": { "size": 2, "capacity": 20, "throughput": 30, "rubbleHp": 500, "link": 600, "spacing": 120, "speed": 30,
                  "exposeTicks": 200, "flatGrade": 0, "hillGrade": 15, "depth": 2, "walls": true, "mound": 70, "hillMound": 80,
                  "apron": 2, "blend": 5, "emergeDamage": 40, "restoreTicks": 600 }
    },
    {
      "id": "tunnel_hatch", "name": "Infantry hatch", "glyph": "j", "tags": ["structure", "tunnel", "stealth"],
      "locomotor": "none", "armor": "building", "height": 10, "hp": 500, "vision": 30, "cost": 0, "hidden": true,
      "footprint": { "w": 2, "h": 2 }, "buildTime": 200,
      "construction": { "startHp": 10, "stages": [15, 40, 70, 95], "refund": 75, "helpers": [100, 50, 0], "padBlend": 0 },
      "tunnel": { "size": 1, "capacity": 8, "throughput": 40, "rubbleHp": 250, "link": 600, "spacing": 120, "speed": 30,
                  "exposeTicks": 200, "flatGrade": 0, "hillGrade": 15, "depth": 2, "walls": false, "mound": 0, "hillMound": 25,
                  "apron": 1, "blend": 3, "emergeDamage": 40, "restoreTicks": 600 }
    },
    // Garrisonable city blocks (art/export/block_panel_5.glb, block_brick_4.glb; 1 cell = 2 m).
    // Placed neutral; infantry (workers too) walk to a door and go in, up to capacity; the
    // building belongs to whoever is inside. garrison: who may enter (tags), how close to a door
    // they must get (enterRange, tenths of a cell), range and vision added for occupants (tenths),
    // the percent of an occupantWarheads hit on the building every occupant takes too, the HP
    // percent thresholds of the damage stages (stage 0 above the first; rubble at 0 HP), the
    // percent of capacity each stage holds (the excess is thrown out, losing ejectDamage percent
    // of max HP), and at collapse each occupant's percent chance to survive at collapseHp percent
    // of max HP. doors: cells just outside the footprint, from its top-left cell; the front
    // (entrances) faces south (+y). Bullets barely scratch them (building armor).
    {
      "id": "block_panel_5", "name": "Panel block (5 floors)", "glyph": "B", "tags": ["structure", "garrisonable"],
      "locomotor": "none", "armor": "building", "height": 154, "hp": 2400, "vision": 0, "cost": 0,
      "footprint": { "w": 23, "h": 6 }, "buildTime": 1200,
      "garrison": {
        "capacity": 10, "tags": ["infantry"], "enterRange": 12, "rangeBonus": 20, "visionBonus": 40,
        "occupantDamage": 25, "occupantWarheads": ["rocket", "explosive", "heavy_rocket", "heavy_missile", "ballistic", "atgm"],
        "stages": [80, 60, 35], "stageCapacity": [100, 100, 75, 50], "ejectDamage": 20,
        "collapseSurvival": 50, "collapseHp": 30,
        "doors": [[4, 6], [11, 6], [19, 6]]
      }
    },
    {
      "id": "block_brick_4", "name": "Brick block (4 floors)", "glyph": "b", "tags": ["structure", "garrisonable"],
      "locomotor": "none", "armor": "building", "height": 165, "hp": 1600, "vision": 0, "cost": 0,
      "footprint": { "w": 14, "h": 7 }, "buildTime": 1000,
      "garrison": {
        "capacity": 6, "tags": ["infantry"], "enterRange": 12, "rangeBonus": 20, "visionBonus": 40,
        "occupantDamage": 25, "occupantWarheads": ["rocket", "explosive", "heavy_rocket", "heavy_missile", "ballistic", "atgm"],
        "stages": [80, 60, 35], "stageCapacity": [100, 100, 75, 50], "ejectDamage": 20,
        "collapseSurvival": 50, "collapseHp": 30,
        "doors": [[2, 7], [11, 7]]
      }
    },
