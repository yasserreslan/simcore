{
  // Entities that soldiers launch or place, never fielded on their own.
  // lifetime is in ticks: an FPV drone's battery.
  "archetypes": [
    {
      "id": "fpv_drone", "name": "FPV drone", "glyph": "F", "tags": ["drone"],
      "locomotor": "flying", "armor": "drone", "hp": 15, "speed": 60, "turnRate": 8,
      "vision": 40, "lifetime": 200, "cost": 30, "components": ["fpv_charge"],
      // An air target (E6): air defence and the jets engage it as the "fpv" class, flying 8 m up.
      "airBody": { "class": "fpv", "height": 80 }
    },
    {
      "id": "booby_trap", "name": "Booby trap", "glyph": "^", "tags": ["trap"],
      "locomotor": "none", "armor": "building", "hp": 5, "hidden": true, "cost": 20,
      "components": ["trap_charge"]
    },
    {
      // The anti-personnel mine (a PMN-2-type pressure mine; docs/design.md, "Traps"), laid by assault
      // infantry. Hidden: only a sniper, a scout drone or an observation post reveals it.
      "id": "ap_mine", "name": "Anti-personnel mine", "glyph": "^", "tags": ["trap", "mine"],
      "locomotor": "none", "armor": "building", "hp": 5, "hidden": true, "cost": 0,
      "components": ["ap_mine_charge"]
    },
    {
      // The anti-tank mine (a TM-62-type box mine), laid by assault infantry: a vehicle on it is destroyed.
      "id": "at_mine", "name": "Anti-tank mine", "glyph": "^", "tags": ["trap", "mine"],
      "locomotor": "none", "armor": "building", "hp": 8, "hidden": true, "cost": 0,
      "components": ["at_mine_charge"]
    },
    {
      // An engineer's drone station: a rail with one drone, fired remotely (attack ground) by
      // its owner, on its own once placed. Spent, its empty rail stays 20 s.
      "id": "drone_station", "name": "Drone station", "glyph": "%", "tags": ["station"],
      "locomotor": "none", "armor": "light_vehicle", "hp": 60, "radius": 5, "turret": true, "hidden": true, "cost": 0,
      "expireWhenEmpty": 400, "height": 12, "components": ["drone_station_rail"]
    },
    {
      // The scout drone (an Orlan-10-type fixed wing; docs: the game repo's docs/air-defense-design.md,
      // section 10). Unarmed: it spots. Launched by the scout truck or a sniper's scout station, it
      // climbs at 5 m/s to 80 m over the ground, flies at 5 cells/s (slower than every attack drone)
      // to the point it is sent to and orbits it 20 cells out. Vision 50 cells (it sees over terrain
      // and woods once fog of war lands: it is an air unit). Endurance 4 min (lifetime); with 10 s to
      // spare it turns for home and lands at its launcher (3 cells), which can relaunch it after a
      // 30 s turnaround. Only air defence reaches it (Osa-type 20% at best, AA soldier 5%); its hp
      // never matters. Its camera reveals hidden traps within 25 cells of the point under it (detect;
      // its orbit is 20 cells out, so it covers the point it circles), in sight of its side.
      "id": "scout_drone", "name": "Scout drone", "glyph": "o", "tags": ["drone"],
      "locomotor": "flying", "armor": "drone", "hp": 40, "speed": 50, "turnRate": 2,
      "vision": 500, "detect": 250, "lifetime": 4800, "cost": 0,
      // It may fly 48 cells past the map's edge (the fly zone's default; twice its 9.6-cell turn radius plus a second: 24.2).
      "flight": { "height": 800, "climbRate": 50, "launchHeight": 25, "orbitRadius": 200, "turnRate": 30,
                  "interceptible": "scout", "reserve": 200, "recoverRange": 30, "turnaround": 600 }
    },
    {
      // A sniper's scout station: a small launch rail with one scout drone, launched by its owner at a
      // point (the Launch command); hidden like the drone station. Its drone lost, it goes 20 s later.
      "id": "scout_station", "name": "Scout drone station", "glyph": "&", "tags": ["station"],
      "locomotor": "none", "armor": "light_vehicle", "hp": 60, "radius": 5, "hidden": true, "cost": 0,
      "expireWhenEmpty": 400, "height": 12, "components": ["scout_station_launch"]
    }
  ]
}
