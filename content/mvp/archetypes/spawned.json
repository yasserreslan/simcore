{
  // Entities that soldiers launch or place, never fielded on their own.
  // lifetime is in ticks: an FPV drone's battery.
  "archetypes": [
    {
      "id": "fpv_drone", "name": "FPV drone", "glyph": "F", "tags": ["drone"],
      "locomotor": "flying", "armor": "drone", "hp": 15, "speed": 60, "turnRate": 8,
      "vision": 60, "lifetime": 200, "cost": 30, "components": ["fpv_charge"],
      // An air target (E6): air defence and the jets engage it as the "fpv" class, flying 8 m up.
      "airBody": { "class": "fpv", "height": 80 },
      // INF-EE (the owner, 2026-11-20: "fpv drone can be for surveillance or for attack"): launched for surveillance (UseAbility
      // with "on"), it flies to the point and circles it 3 cells out, seeing 8 cells round it for its 3-minute battery (from the
      // launch), then crashes; an Attack order on an enemy it sees sends it down as in attack mode.
      "surveil": { "vision": 80, "battery": 3600, "radius": 30 }
    },
    {
      "id": "booby_trap", "name": "Booby trap", "glyph": "^", "tags": ["trap"],
      "locomotor": "none", "armor": "building", "hp": 5, "hidden": true, "cost": 20,
      "components": ["trap_charge"]
    },
    {
      // INF-EX: the sapper's building trap, inside the building it rigs (at its centre; Unit.Host). Hidden; never a target and
      // never hurt: only its rules remove it (set off, lifted, disarmed, its building gone).
      "id": "building_trap", "name": "Building trap", "glyph": "^", "tags": ["trap"],
      "locomotor": "none", "armor": "building", "hp": 5, "hidden": true, "targetable": false, "invulnerable": true, "cost": 0,
      "components": ["building_trap_charge"]
    },
    {
      // INF-EX: the sapper's remote demolition charge, on a building's wall, a bridge or a vehicle (it rides on it; Unit.Host).
      "id": "demo_charge", "name": "Demolition charge", "glyph": "^", "tags": ["trap"],
      "locomotor": "none", "armor": "building", "hp": 5, "hidden": true, "targetable": false, "invulnerable": true, "cost": 0,
      "components": ["demo_charge_block"]
    },
    {
      // The supply crate (CrateSystem.cs, decision 1101): one for both sides, owned by the side that dropped it: a cargo truck's
      // whole load dropped at its tail (DropCrate), or an airdropped pallet that landed outside every drop zone. About 1.5 x 1
      // cells (the client's model; no size block: it never shelters), no footprint: it blocks nothing and is never built. 150 HP of
      // light armour; sees 2 cells. A small depot (crate_supply). Proposed numbers.
      "id": "supply_crate", "name": "Supply crate", "glyph": "c", "tags": ["crate"],
      "locomotor": "none", "armor": "light_vehicle", "hp": 150, "vision": 20, "cost": 0,
      "components": ["crate_supply"]
    },
    {
      // The anti-personnel mine (a PMN-2-type pressure mine; docs/design.md, "Traps"), laid by assault
      // infantry. Hidden: only a sniper, a scout drone or an observation post reveals it.
      "id": "ap_mine", "name": "Anti-personnel mine", "glyph": "^", "tags": ["trap", "mine"],
      "locomotor": "none", "armor": "building", "hp": 5, "hidden": true, "cost": 0,
      "components": ["ap_mine_charge"]
    },
    {
      // The anti-tank mine (a TM-62-type box mine), laid by assault infantry: a vehicle on it is destroyed.
      "id": "at_mine", "name": "Anti-tank mine", "glyph": "^", "tags": ["trap", "mine"],
      "locomotor": "none", "armor": "building", "hp": 8, "hidden": true, "cost": 0,
      "components": ["at_mine_charge"]
    },
    {
      // An engineer's drone station: a rail with one drone, fired remotely (attack ground) by
      // its owner, on its own once placed. Spent, its empty rail stays 20 s.
      "id": "drone_station", "name": "Drone station", "glyph": "%", "tags": ["station"],
      "locomotor": "none", "armor": "light_vehicle", "hp": 60, "radius": 5, "turret": true, "hidden": true, "cost": 0,
      "expireWhenEmpty": 400, "height": 12, "components": ["drone_station_rail"]
    },
    {
      // The Kaman drone (a Kaman-22 type long-range attack drone, an MQ-9-like airframe; docs/design.md, "Kaman
      // drone"). A flying unit, not a projectile: air defence and the jets engage it as the "kaman" class (2 Igla hits,
      // 1 air defence missile hit), it is tracked on radar and it spots for its side (40 cells, over ridges and woods as
      // any air unit). Launched by the Kaman truck's rail or an engineer's Kaman station at a unit (it follows it) or a
      // point, it takes no orders: it climbs at up to 12 m/s to 150 m over the ground, cruises at 15 cells/s (the one-way
      // drone: 12), turning at 60 degrees a second to follow its target; a target its side stops seeing is flown to
      // where it was last seen. From 30 cells it fires its two missiles (kaman_missiles) at the target a second apart,
      // pitches over in 2 s into a 45-degree dive and goes off in the target: 520 through kaman_charge in a 6-cell blast
      // (100% at the centre to 40% at its edge; a building loses 45% of its max HP). 100 s of fuel (lifetime: 1,500 cells
      // of flight, the 1,200-cell launch range and a target that drives away); shot down, its wreck falls (loss).
      "id": "kaman_drone", "name": "Kaman drone", "glyph": "k", "tags": ["drone"],
      "locomotor": "flying", "armor": "drone", "hp": 200, "speed": 150, "turnRate": 2,
      "vision": 600, "lifetime": 2000, "cost": 0, "components": ["kaman_missiles"],
      "flight": { "height": 1500, "climbRate": 120, "launchHeight": 30, "orbitRadius": 200, "turnRate": 60,
                  "interceptible": "kaman", "reserve": 0, "recoverRange": 10, "turnaround": 0 },
      "kaman": { "damage": 520, "warhead": "kaman_charge", "splash": 60, "splashCenter": 100, "splashEdge": 40,
                 "dive": 1000, "pitchOver": 40, "runway": { "crater": "large" } },
      "loss": { "crash": { "warhead": "crash", "damage": 100, "splash": 20, "gravity": 400, "drag": 10, "breakUp": 50, "breakUpDrag": 50,
                           "runway": { "crater": "small" } } }
    },
    {
      // The engineer's Kaman station (the Kaman option of his drone station): a long rail with one Kaman drone, fired
      // remotely by its owner (an attack or attack-ground order; it never picks a target itself: holdFire), on its own
      // once placed. Spent, its empty rail stays 20 s.
      "id": "kaman_station", "name": "Kaman station", "glyph": "%", "tags": ["station"],
      "locomotor": "none", "armor": "light_vehicle", "hp": 80, "radius": 8, "turret": true, "hidden": true, "cost": 0,
      "stance": "holdFire", "expireWhenEmpty": 400, "height": 15, "components": ["kaman_station_rail"]
    },
    {
      // The scout drone (an Orlan-10-type fixed wing; docs: the game repo's docs/air-defense-design.md,
      // section 10). Unarmed: it spots. Launched by the scout truck or a sniper's scout station, it
      // climbs at 5 m/s to 80 m over the ground, flies at 5 cells/s (slower than every attack drone)
      // to the point it is sent to and orbits it 20 cells out. Vision 50 cells (under fog it sees over terrain
      // and woods: it is an air unit; under the trees only its camera looks: concealment.json). Fuel 9 min (lifetime; the owner,
      // 2026-11-02): it never comes home (recover false: no trip back, no recovery, no turnaround); when the fuel runs out it
      // falls and is destroyed wherever it is (its loss block: a small wreck, a 1-cell crash), and its launcher needs a new
      // drone (kits.json). Only air defence reaches it (Osa-type 20% at best, AA soldier 5%); its hp
      // never matters. Its camera reveals hidden traps within 25 cells of the point under it (detect;
      // its orbit is 20 cells out, so it covers the point it circles), in sight of its side.
      "id": "scout_drone", "name": "Scout drone", "glyph": "o", "tags": ["drone"],
      "locomotor": "flying", "armor": "drone", "hp": 40, "speed": 50, "turnRate": 2,
      "vision": 750, "detect": 250, "lifetime": 10800, "cost": 0, // 9 min (the owner 2026-11-18: "9 minutes of fly time instead of 4")
      // It may fly 48 cells past the map's edge (the fly zone's default; twice its 9.6-cell turn radius plus a second: 24.2).
      "flight": { "height": 800, "climbRate": 50, "launchHeight": 25, "orbitRadius": 200, "turnRate": 30,
                  "interceptible": "scout", "recover": false },
      // Out of fuel or shot down, its wreck falls (gravity, drag as the Kaman drone's) and goes off small: 30 in a 1-cell splash.
      "loss": { "crash": { "warhead": "crash", "damage": 30, "splash": 10, "gravity": 400, "drag": 10, "breakUp": 50, "breakUpDrag": 50 } }
    },
    {
      // The Samad (a high-altitude recon drone; docs/design.md, "Samad recon drone"; the game repo's docs/plans/samad-spec.md, the
      // owner 2026-11-16). Unarmed: it spots, as the scout drone does, higher, faster and farther. Launched off its truck's rail
      // (samad_rail) at a point, it climbs at 15 m/s to 450 m over the ground, flies at 30 cells/s (twice the Kaman drone's 15) to
      // the point and orbits it 60 cells out (turning 80 degrees a second: a 21-cell radius, so its fly zone, 73 cells, stays inside
      // the stealth multirole's 74); it takes the scout drone's orders (a new point, a patrol route). Vision 100 cells
      // (an air unit's sight over ridges and woods; units hidden under trees stay hidden from it: concealment.json). Fuel 6 min
      // (lifetime: 10,800 cells of flight, four times across the largest map's diagonal); it never comes home (recover false: the
      // scout drone's rule of 2026-11-02) and crashes where it is when the fuel runs out. Its own air class ("samad"): at 450 m it
      // flies over the AA soldier's (320 m), the ZU-23's and the air defence vehicle's (440 m) ceilings, so only the Patriot and
      // THAAD types and the jets' air-to-air reach it (the Korkut and the SA-6 never engage it: not their class); climbing out
      // under a ceiling it can be shot at. A small radar signature: every sensor detects it at half its range (detect 50).
      "id": "samad_drone", "name": "Samad drone", "glyph": "s", "tags": ["drone"],
      "locomotor": "flying", "armor": "drone", "hp": 100, "speed": 300, "turnRate": 2,
      "vision": 1000, "lifetime": 7200, "cost": 0,
      "signature": { "detect": 50 },
      "flight": { "height": 4500, "climbRate": 150, "launchHeight": 30, "orbitRadius": 600, "turnRate": 80,
                  "interceptible": "samad", "recover": false },
      // Out of fuel or shot down, its wreck falls (as the scout drone's) and goes off: 50 in a 1.5-cell splash.
      "loss": { "crash": { "warhead": "crash", "damage": 50, "splash": 15, "gravity": 400, "drag": 10, "breakUp": 50, "breakUpDrag": 50 } }
    },
    {
      // A sniper's scout station: a small launch rail with one scout drone, launched by its owner at a
      // point (the Launch command); hidden like the drone station. Its drone lost, it goes 20 s later.
      "id": "scout_station", "name": "Scout drone station", "glyph": "&", "tags": ["station"],
      "locomotor": "none", "armor": "light_vehicle", "hp": 60, "radius": 5, "hidden": true, "cost": 0,
      "expireWhenEmpty": 400, "height": 12, "components": ["scout_station_launch"]
    }
  ]
}
