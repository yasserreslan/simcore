{
  // Units: speed in tenths of a cell per second (infantry move at a run, about
  // 1.7-1.9 cells = 3.4-3.8 m/s); vision, detect and ranges in
  // tenths of a cell; turnRate in facings per tick; buildTime: ticks the
  // barracks (resistance_barracks) takes to train it. Every number is a
  // starting value for tuning.
  //
  // slots lists what a preset may pick for each slot; a preset picks one per
  // slot. Archetypes without slots ("no loadout") have no presets.
  "archetypes": [
    {
      "id": "assault", "name": "Assault", "glyph": "A", "tags": ["infantry", "soldier"],
      "locomotor": "foot", "armor": "infantry", "crushable": 1, "hp": 60, "speed": 19, "turnRate": 8, "vision": 105, "cost": 100, "buildTime": 100,
      // Shared archetypes list both sides' arms; the faction lists filter (INF-E1a: the Resistance's res_*).
      "slots": { "primary": ["rifle", "smg", "lmg", "res_rifle", "res_smg", "res_lmg"], "secondary": ["pistol", "res_pistol"] },
      "components": ["ap_mine_kit", "at_mine_kit"] // lays both mine types (docs/design.md, "Traps")
    },
    {
      // INF-EE (the owner, 2026-11-20: "one for drones one for explosives only"): two engineers on one engineer base (the same
      // numbers in both; the old single "engineer" and its kit presets are gone). Both carry the carbine (the main arm) and the
      // pistol (the sidearm) and the repair kit (the Repair order on a vehicle, RepairSystem.cs); fixed components, no presets.
      // He does not detect traps: only the sniper, the scout drone and the observation post do (2026-10-18).
      // The drone engineer: two FPV drones (attack, or surveillance: the fpv_drone's surveil block), the drone station and its
      // Kaman option (docs/design.md, "Kaman drone"). 120 + carbine 10 + pistol 5 + repair kit 20 + drone kit 40 = 195.
      "id": "engineer_drone", "name": "Drone engineer", "glyph": "E", "tags": ["infantry", "soldier"],
      "locomotor": "foot", "armor": "infantry", "crushable": 1, "hp": 50, "speed": 18, "turnRate": 8, "vision": 90, "cost": 120, "buildTime": 120,
      "pursue": false,
      "components": ["drone_kit", "res_carbine", "res_pistol", "repair_kit", "drone_station_kit", "kaman_station_kit"] // his kit first (stock 0), as before
    },
    {
      // The sapper: explosives only: booby traps (the trap kit: 3 charges, 3 active) and the assault's AT and AP mines with his
      // limits (8 AP and 4 AT on the map). Later: a building charge (the owner will define it).
      // 120 + carbine 10 + pistol 5 + repair kit 20 + trap kit 20 + AP mines 20 + AT mines 30 = 225.
      "id": "engineer_sapper", "name": "Sapper", "glyph": "X", "tags": ["infantry", "soldier"],
      "locomotor": "foot", "armor": "infantry", "crushable": 1, "hp": 50, "speed": 18, "turnRate": 8, "vision": 90, "cost": 120, "buildTime": 120,
      "pursue": false,
      "components": ["trap_kit", "res_carbine", "res_pistol", "repair_kit", "ap_mine_kit", "at_mine_kit"] // his trap kit first (stock 0), as before
    },
    {
      "id": "anti_armor", "name": "Anti-armor", "glyph": "K", "tags": ["infantry", "soldier", "rpg"],
      // Keeps to the launcher; set "auto" per unit to let it use its sidearm. INF-E1a: a soldier whose sidearm has a draw time
      // (the Resistance's carbine) starts in auto and switches by the rule; primaryOnly stays the player's override. The
      // Resistance's booby trap is equipment (a fixed component of its own), no longer a sidearm.
      "weaponMode": "primaryOnly",
      "locomotor": "foot", "armor": "infantry", "crushable": 1, "hp": 55, "speed": 17, "turnRate": 8, "vision": 120, "cost": 200, "buildTime": 140,
      "slots": { "primary": ["at_missile", "aa_missile"], "secondary": ["short_rifle", "res_carbine"] },
      "factionComponents": { "resistance": ["booby_trap"] }
    },
    {
      // The Kornet guided missile team: slow, fragile, deadly to vehicles at long range.
      "id": "kornet", "name": "Kornet team", "glyph": "G", "tags": ["infantry", "soldier", "atgm"],
      "weaponMode": "primaryOnly",
      "locomotor": "foot", "armor": "infantry", "crushable": 1, "hp": 55, "speed": 14, "turnRate": 8, "vision": 135, "cost": 500, "buildTime": 240,
      "components": ["kornet_atgm", "res_carbine"] // fixed weapons: no loadout, no preset needed (INF-E1a: the carbine as sidearm)
    },
    {
      // The air defence soldier: an Igla-style shoulder-fired IR missile against one-way attack
      // drones. He detects them in the air out to 150 cells (airVision, a slant distance), tracks
      // one, and fires once locked (see the igla component and docs/air-defense-design.md in the
      // game repo). Nothing else: no ground weapon.
      "id": "manpads", "name": "Air defence soldier", "glyph": "Y", "tags": ["infantry", "soldier", "manpads"],
      "locomotor": "foot", "armor": "infantry", "crushable": 1, "hp": 55, "speed": 17, "turnRate": 8, "vision": 120, "airVision": 1500, "cost": 300, "buildTime": 160,
      "components": ["igla"], // one fixed weapon: no loadout, no preset needed
      "factionComponents": { "resistance": ["res_carbine"] } // INF-E1a: the Resistance's carries the carbine as sidearm
    },
    {
      // Sees far and reveals enemy traps (and stations) within 5 cells; drops a scout drone station for spotting.
      "id": "sniper", "name": "Sniper", "glyph": "S", "tags": ["infantry", "soldier", "sniper"],
      "locomotor": "foot", "armor": "infantry", "crushable": 1, "hp": 45, "speed": 17, "turnRate": 8, "vision": 210, "detect": 50, "cost": 200, "buildTime": 160,
      "slots": { "primary": ["res_sniper"], "secondary": ["res_pistol", "res_smg"] }, // INF-E1a: the Resistance's arms
      "components": ["scout_station_kit"],
      // Fieldcraft (owner 2026-11-20, "snipers have faster camouflage abilities between trees"; the engine's docs/design.md,
      // "Fieldcraft"): still 1 s in scrub, a grove or dense forest he is concealed; enemy ground units (detectors apart) then spot
      // him only within 3 cells in scrub, 2 in a grove, 1.5 in dense forest (tenths of a cell per density [none, scrub, grove,
      // dense]; -1: today's rules), twice that while he crawls (moves at most half his speed); walking breaks it. A shot reveals
      // him for 1.5 s; still, he hides again 1 s after his last shot. From the air, concealed and still in scrub or a grove, he
      // counts as in dense forest. Only where spotting applies (fog of war on a terrain map).
      "fieldcraft": { "settleTicks": 20, "groundReach": [-1, 30, 20, 15], "crawlMultiplier": 2, "fireRevealTicks": 30, "rehideTicks": 20, "airAsDense": true }
    },
    {
      // The mortar soldier (docs/design.md, "Mortar"): one man carrying a light mortar (tube, bipod, base
      // plate) and a pack of 10 bombs. The slowest soldier (13: the load), fragile and short-sighted: he
      // sees 9 cells and shells what others spot, or any point in range on attack ground (fog or not). He
      // sets up in 5 s before the first round and packs up in 3 s before he can walk, and like the
      // launchers fires only on orders (attack ground, or an attack on a spotted unit). Inside a building
      // he fires only from an observation post (its garrison's deployTags); anywhere else he holds fire.
      "id": "mortar", "name": "Mortar", "glyph": "R", "tags": ["infantry", "soldier", "mortar"],
      "weaponMode": "primaryOnly",
      "locomotor": "foot", "armor": "infantry", "crushable": 1, "hp": 50, "speed": 13, "turnRate": 8, "vision": 90, "cost": 400, "buildTime": 200,
      "deployTicks": 100, "stowTicks": 60,
      "autoFireDeployed": true, // set up (on orders only), it fires on its own at spotted targets in range
      "components": ["mortar_tube", "res_carbine"] // fixed weapons: no loadout, no preset needed (INF-E1a: the carbine as sidearm)
    },
    {
      // Builds and mines from Phase 2; unarmed, no loadout, can't drive.
      "id": "worker", "name": "Worker", "glyph": "W", "tags": ["infantry", "worker"],
      "locomotor": "foot", "armor": "infantry", "crushable": 1, "hp": 40, "speed": 18, "turnRate": 8, "vision": 75, "cost": 50, "buildTime": 80, "pursue": false,
      "mining": { "goldPerMinute": 24, "load": 10 }, // the gold economy: 40% of the miner's rate (proposed), loads of 10
      "components": ["worker_build"]
    }
  ]
}
