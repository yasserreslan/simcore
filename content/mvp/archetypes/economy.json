  // The gold economy (docs/design.md, "Gold economy"; the game repo's docs/plans/economy-spec.md, the owner's words of 2026-11-08).
  // Numbers marked proposed in the spec are starting points to tune. Spots are in tenths of a cell from the footprint's unturned
  // top-left corner (x east, y south; the front faces south), copied from the art's sidecars (glTF metres from the footprint's
  // centre, X along x and Z along y, times 5): the banks from branch banks-art (art/export/bank_*.json: unload_spot, walk_in),
  // the mines from branch gold-mines-art at dcede2f2 (art/export/gold_*.json: load_spot, work_01..; the final look keeps them). The
  // look may change; update the offsets here. A mine's solid rows are the cells its art's base and full-stage geometry fills
  // between 0.6 and 2.5 m up (a body's height: the overhead parts of conveyors, flumes and wheels don't count), every spot's cell kept open and
  // connected to the footprint's edge, enclosed pockets filled: the game repo's art/scripts/gold_mine_solid.py works them out from
  // the glbs (the final look, ECON-ART-1D, decision 1065).
  "archetypes": [
    {
      // The miner (both factions): an unarmed foot unit that mines gold fastest (proposed: 1 gold/s, loads of 10). Trained
      // where each side trains foot units (the Resistance barracks; the Sentinel trains none yet). The worker's model stands in
      // until its art (ECON-ART-2). Proposed: 75 gold, 15 s. The worker's HP, armour and speed.
      "id": "miner", "name": "Miner", "glyph": "n", "tags": ["infantry", "miner"],
      "locomotor": "foot", "armor": "infantry", "crushable": 1, "hp": 40, "speed": 18, "turnRate": 8, "vision": 75, "cost": 75, "buildTime": 300, "pursue": false,
      "mining": { "goldPerMinute": 60, "load": 10 }
    },
    // The banks (one look per faction; the art's ECON-ART-3): their side's gold drop-off. Trucks unload and miners on foot hand in
    // gold at the nearest of their side's banks; the gold is the player's reserve, not the bank's, so a destroyed bank loses none
    // (with no bank left, loads wait). 28 x 24 m, built by workers and the bulldozer. Proposed: 1,500 gold, 60 s. 2,500 HP of
    // building armour (the vehicle garage's), sees 15 cells.
    {
      // The Resistance's: a requisitioned old town savings bank, its yard's loading bay on the east of the front.
      "id": "bank_resistance", "name": "Savings bank", "glyph": "$", "tags": ["structure", "bank"],
      "locomotor": "none", "armor": "building", "height": 66, "hp": 2500, "vision": 75, "cost": 1500,
      "footprint": { "w": 14, "h": 12 }, "buildTime": 1200,
      "construction": { "startHp": 10, "stages": [15, 40, 70, 95], "refund": 75, "helpers": [100, 50, 0], "padBlend": 3 },
      "bank": { "unload": [110, 76], "walkIn": [50, 103] }
    },
    {
      // The Sentinel's: a modern secure finance depot, its covered loading bay behind the vehicle lock.
      "id": "bank_sentinel", "name": "Finance depot", "glyph": "$", "tags": ["structure", "bank"],
      "locomotor": "none", "armor": "building", "height": 54, "hp": 2500, "vision": 75, "cost": 1500,
      "footprint": { "w": 14, "h": 12 }, "buildTime": 1200,
      "construction": { "startHp": 10, "stages": [15, 40, 70, 95], "refund": 75, "helpers": [100, 50, 0], "padBlend": 3 },
      "bank": { "unload": [110, 59], "walkIn": [65, 92] }
    },
    // The gold mines: neutral map features the map places (never built), on both rosters as the bridges are. Not attackable, never
