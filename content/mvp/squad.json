{
  // Infantry squads (the engine's docs/design.md, "Infantry squads"; the owner's spec of 2026-10-27, phase S1): up to 10
  // soldiers of one player ordered as one, each doing his class's job in the squad's shape. Distances in tenths of a cell
  // (1 cell = 2 m), speeds in percent of the slowest member's, times in ticks (20 a second). Starting values for tuning.
  "squad": {
    "size": [2, 10],               // a squad holds 2 to 10; at 1 member it disbands
    "need": ["infantry"],          // only infantry join
    "never": ["worker", "pilot"],  // workers and pilots never do
    // The role of each class, by tag: the first entry whose tag the soldier's class has; none: "line" (riflemen, engineers).
    "roles": [
      { "tag": "medic", "role": "medic" },
      { "tag": "sniper", "role": "recon" },
      { "tag": "rpg", "role": "flank" },
      { "tag": "atgm", "role": "longFlank" },
      { "tag": "manpads", "role": "airGuard" },
      { "tag": "mortar", "role": "support" }
    ],
    "noLead": ["medic", "recon", "support"], // the leader is the lowest-ID member of another role
    // March: a file along the path at the slowest member's speed. Recon walks ahead, the flanks behind the leader, the medic
    // in the middle, the long flank, the air guards (3 cells apart) and the support (packed) at the rear.
    "march": { "spacing": 15, "speed": 100, "ahead": 50, "airGuardGap": 30, "supportGap": 10 },
    // Assault: a line facing the move, 2 cells apart, at 80%; the flanks at its ends. Behind it, [back, gap across]: the medic
    // 3 cells back, recon 4 back beyond the right end (reconSide), the long flank 4 back, the air guards 5 back 3 apart, the
    // support 7 back, packed.
    "assault": {
      "spacing": 20, "speed": 80,
      "medic": [30, 20], "recon": [40, 20], "reconSide": 20, "longFlank": [40, 20], "airGuard": [50, 30], "support": [70, 10]
    },
    "regroup": 40,        // a member more than 4 cells off his slot makes a moving squad wait for him ...
    "regroupTicks": 60,   // ... for 3 s at most, then it walks on
    "groupGap": 120,      // the squads of one move order stand 12 cells apart, side by side across the move
    // Hold (phase S2): each member takes the best cell for his role near the spot, facing the dragged direction, and stays
    // until a new order. Every free cell within 12 cells of the spot is scored once per order (at most 600, the nearest
    // first); members pick in the order below, each the best cell left; ties go to the lowest cell index.
    "hold": {
      "radius": 120,
      "cells": 600,
      "threat": 100,              // no facing dragged: the threat 10 cells ahead of the spot along the squad's facing
      "threatRange": [40, 300],   // dragged: where the drag ends, kept 4 to 30 cells from the spot
      "laneMax": 300,             // sight lanes walked out to 30 cells at most (a soldier's own: his sight or reach, the longer)
      "laneSpread": 60,           // three lanes: at the threat and 6 cells either side of it
      // Cover points (a cell's cover is their sum, at most 100): a wall, rubble, a building or rock next to the cell on the
      // threat's side; a tree trunk there; the cell in a grove or dense forest; a crest hiding the cell from the threat.
      "cover": { "wall": 60, "trunk": 30, "grove": 25, "dense": 40, "crest": 50 },
      "order": ["recon", "longFlank", "flank", "line", "airGuard", "support", "medic"],
      // Each role: weights [cover, trees, sight, open, spacing, safety, range, near] (each factor scores 0 to 100); back: the
      // least depth along the facing behind the line soldiers placed before him (before any: behind the spot; negative: so far
      // ahead is allowed); apart: [from anyone, from the same role] at least; spread: where spacing scores in full; garrison: a
      // garrisonable building counts as a position (his weapon helps from inside).
      "roles": {
        "line":      { "weights": [5, 0, 3, 0, 2, 0, 1, 4], "back": -120, "apart": [15, 0],  "spread": 30, "garrison": true },
        "medic":     { "weights": [5, 0, 0, 0, 1, 2, 0, 6], "back": 20,   "apart": [15, 0],  "spread": 20, "garrison": false },
        "recon":     { "weights": [1, 0, 8, 1, 1, 1, 0, 0], "back": 0,    "apart": [15, 0],  "spread": 40, "garrison": true },
        "flank":     { "weights": [3, 0, 4, 4, 2, 0, 3, 1], "back": -120, "apart": [15, 0],  "spread": 40, "garrison": true },
        "longFlank": { "weights": [2, 0, 6, 2, 1, 2, 4, 0], "back": 0,    "apart": [15, 0],  "spread": 40, "garrison": false },
        "airGuard":  { "weights": [1, 8, 0, 0, 3, 1, 0, 1], "back": -120, "apart": [15, 80], "spread": 80, "garrison": false },
        "support":   { "weights": [3, 0, 0, 0, 1, 3, 3, 0], "back": 100,  "apart": [15, 0],  "spread": 30, "garrison": false }
      }
    },
    // Ambush (phase S3): a trap round a kill zone the player drags (its start where the enemy comes in, its far end where the
    // column is stopped). The squad scores both sides of the zone with Hold's factors (the zone as the threat) and takes the
    // better one; everyone stays on that side. The line lays mines from its own stock, everyone holds fire, and the trap springs
    // on its own on the first of: an enemy vehicle at the far end or a crowd in the zone, a mine in it going off, an enemy
    // spotting a member, a member hurt, or the player's Fire.
    "ambush": {
      "length": [60, 300],   // the kill zone: 6 to 30 cells (other orders are refused)
      "radius": 120,         // cells within 12 cells of the zone, on one side, are scored ...
      "cells": 600,          // ... at most 600, the nearest the zone first
      "width": 20,           // the zone reaches 2 cells either side of its line
      "spot": 50,            // a squad farther than the radius from the side's spot (5 cells out from the middle) marches there first
      "approach": 100,       // the approach watched: 10 cells before the zone's start
      "farEnd": 30,          // an enemy vehicle within 3 cells of the far end springs it ...
      "crowd": 3,            // ... or 3 enemies in the zone
      "vehicles": ["vehicle"],
      "rearmTicks": 200,     // sprung, 10 s without a fight: Ready again (mines are not laid again)
      "setTicks": 1200,      // Setting for 60 s at most (a member who can't reach his position): Ready then
      // Mines: the line lays them from its own stock (the assault soldier's 4 AP and 2 AT, the engineer's booby trap: one), AT mines
      // on the road along the zone 2 cells apart from the far end back, AP mines and traps 3 cells apart on the cover 1 to 4 cells
      // off the zone's line on its far side (where infantry would run).
      "mines": { "layers": ["line"], "at": "at_mine", "ap": "ap_mine", "trap": "booby_trap", "trapsEach": 1, "atGap": 20, "apGap": 30,
                 "apBand": [10, 40] },
      // Each role: weights [cover, trees, sight, open, spacing, safety, range, near, end, lane, approach, hidden] (Hold's eight, the
      // zone as the threat: cover from it, sight of its start, middle and far end, range to it, near it; then near the role's end,
      // the lane down the road to the approach seen, the approach point seen, out of sight of the zone); lateral: [nearest,
      // farthest] from the zone's line (0 0: none); back, apart, spread and garrison as in Hold; end: none, near, far or both (in
      // turn, by ID); hide: he must stand out of sight of the zone.
      "roles": {
        "line":      { "weights": [5, 1, 4, 0, 3, 0, 2, 1, 0, 0, 0, 0], "lateral": [30, 80], "back": -120, "apart": [15, 0], "spread": 30,
                       "garrison": true, "end": "none", "hide": false },
        "medic":     { "weights": [4, 1, 0, 0, 1, 2, 0, 3, 0, 0, 0, 3], "lateral": [0, 0], "back": 20, "apart": [15, 0], "spread": 20,
                       "garrison": false, "end": "none", "hide": true },
        "recon":     { "weights": [2, 1, 4, 1, 1, 3, 1, 0, 3, 0, 6, 0], "lateral": [0, 0], "back": 30, "apart": [15, 0], "spread": 40,
                       "garrison": true, "end": "near", "hide": false },
        "flank":     { "weights": [3, 0, 4, 3, 2, 0, 3, 1, 6, 0, 0, 0], "lateral": [20, 90], "back": -120, "apart": [15, 0], "spread": 40,
                       "garrison": true, "end": "both", "hide": false },
        "longFlank": { "weights": [2, 0, 3, 1, 1, 2, 2, 0, 8, 6, 1, 0], "lateral": [0, 0], "back": 0, "apart": [15, 0], "spread": 40,
                       "garrison": false, "end": "far", "hide": false },
        "airGuard":  { "weights": [1, 8, 0, 0, 3, 1, 0, 1, 0, 0, 0, 0], "lateral": [0, 0], "back": -120, "apart": [15, 80], "spread": 80,
                       "garrison": false, "end": "none", "hide": false },
        "support":   { "weights": [3, 0, 0, 0, 1, 3, 4, 0, 0, 0, 0, 2], "lateral": [80, 120], "back": 0, "apart": [15, 0], "spread": 30,
                       "garrison": false, "end": "none", "hide": false }
      },
      // The air ambush (phase S4): a squad more than half Iglas (air guards) given an Ambush sets it round an air corridor instead, the
      // line the player expects aircraft to fly (its start where they come from). The Iglas spread along it, slot points 8 to 15 cells
      // apart (the corridor's length shared out, never closer than 8: one bomb kills one), each under trees near his slot; everyone
      // else guards them, 2 to 5 cells off an Igla toward the likely ground approach (10 cells before the corridor's start; the medic
      // away from it). Everyone holds fire (hidden from the air under trees); no mines. It springs when an enemy aircraft is within
      // reach of 2 of its Iglas (each seeing it himself), a member is hurt, or on the player's Fire; sprung, the Iglas fire together.
      "air": {
        "mostly": 50,              // air guards more than 50% of the squad: an air ambush
        "length": [200, 1200],     // the corridor: 20 to 120 cells (other orders are refused)
        "gap": [80, 150],          // Iglas at least 8 cells apart, always; their slot points at most 15 apart
        "search": 40,              // each member's cells within 4 cells of his slot point (8 when none is left there) ...
        "cells": 600,              // ... at most 600 scored a squad (an Igla with none left looks on, 16 then 32 cells out: never bunched)
        "approach": 100,           // the likely ground approach: 10 cells before the corridor's start
        "guard": [20, 50],         // a guard stands 2 to 5 cells from the Igla he guards, between it and the approach
        "trigger": 2,              // an enemy aircraft within reach of 2 Iglas springs it
        "volleyWait": 20,          // sprung, the Iglas fire together: once the first is locked the rest have 1 s to lock
        // Weights [cover, trees, spacing, near]: cover from the approach, canopy that hides from the air, the distance from the nearest
        // teammate placed (full at the gap's most for an Igla, at the guard's farthest for a guard), near his slot point.
        "airGuard": [0, 8, 3, 2],
        "guards": [5, 2, 2, 4]
      }
    }
  }
}
