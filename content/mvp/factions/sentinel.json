{
  "factions": [
    {
      // The second faction (docs/design.md, "Sentinel faction"): a modern regular army of a fictional
      // country. Its own units: the assault medic, the Watcher and Overseer drones, each with its control station (own lines, so
      // branches adding units merge cleanly). The rest are the shared basics it needs to be playable:
      // riflemen (with the assault soldier's mines), anti-armour and air defence soldiers, workers,
      // the technical, the air defence vehicle, the supply depot and the garage (its own cargo truck replaces the shared one).
      "id": "sentinel", "name": "Sentinel",
      "archetypes": [
        "watcher_station", "watcher_drone", // the Watcher and its control station (own line)
        "overseer_station", "overseer_drone", // the Overseer surveillance drone and its own control station (own line)
        "bulldozer", // the builder vehicle (own line)
        "multirole_jet", "fighter_jet", "pilot", // the jets (built by the airfield facility) and their pilot (E8; own line)
        "airfield_facility", "airfield_row", "airfield_runway", "airfield_shelter", "airfield_stand", // the forward airfield
        "attack_jet", // the ground attack jet (H2; built by the main air base's hangar, parks in a heavy bay; own line)
        "gunship", // the gunship (H3; built by the main air base's hangar, parks in a heavy bay; own line)
        "strategic_bomber", // the strategic bomber (H4; built by the main air base's hangar, parks in a heavy bay; own line)
        "airbase_core", "airbase_command", "airbase_hangar", "airbase_bay", "airbase_radar", "airbase_runway", "radar_site", // the main air base and the radar (H1; own line)
        "patriot_launcher", "radar_truck", "patriot_pad", // the missile defence: launcher, radar truck, reload pad (docs/patriot-design.md; own line)
        "thaad_launcher", // the high-altitude interceptor launcher (docs/patriot-design.md; own line)
        "military_garage", "sentinel_cargo_truck", // the military garage and the Sentinel cargo truck (docs/military-garage-design.md; own line)
        "sentinel_medic", // the assault medic, its first soldier of its own (docs/design.md, "Assault medic"; own line)
        "assault", "anti_armor", "manpads", "worker", "ap_mine", "at_mine",
        "technical", "sam_vehicle",
        "supply_depot", "vehicle_garage"
      ],
      // The parts players may pick for preset slots.
      "components": [
        "rifle", "smg", "lmg", "pistol", "short_rifle", "at_missile", "aa_missile",
        "bombs_500lb", "bombs_2000lb" // the multirole jet's two bomb presets (E8, decision D18)
      ],
      "maxPresetsPerArchetype": 3,
      "defeatedWithout": ["soldier"]
    }
  ]
}
