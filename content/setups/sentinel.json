  // faction for either player from this file and battle.json.
  "scenario": "battle",
  "players": [
    {
      "id": 1, "faction": "sentinel",
      "presets": [
        { "name": "Rifleman", "archetype": "assault", "components": ["rifle", "pistol"] },
