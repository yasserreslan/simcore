                    "minLandRun": 700, "minTakeoffRun": 450,
                    "approach": { "fixDistance": 300, "fixHeight": 150, "touchdown": 100, "flare": 50, "rolloutDecel": 10, "brake": 20 },
                    "speeds": { "approach": 90, "touchdown": 80, "taxi": 35, "turn": 15, "pushback": 5, "takeoff": 90, "takeoffAccel": 20 },
                    "service": { "refuelTicks": 500, "rearmTicksPerRound": 200, "repairHpPerSecond": 12 },
                    "groundVision": 60, "groundEye": 25, "holdReserve": 600, "sortie": true }
    }
  ]
